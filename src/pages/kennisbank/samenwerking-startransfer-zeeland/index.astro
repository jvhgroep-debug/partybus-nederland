---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../components/shared/PartnerImage.astro';
import Button from '../../../components/buttons/Button.astro';
import {buildStarTransferWhatsappTrackingContext} from '../../../lib/partnerWhatsappTracking';
import PhotoHeader from '../../../components/startransfer/PhotoHeader.astro';
import GuideFaqList from '../../../components/guides/GuideFaqList.astro';
import {samenwerkingStarTransferZeeland as article} from '../../../data/kennisbank/articles/samenwerkingStarTransferZeeland';
import {starTransferPhotos,starTransferLogo,zeelandFooter,buildStarTransferWhatsappHref} from '../../../data/partners/starTransfer';
import {buildArticleSchema,buildBreadcrumbSchema,buildFaqPageSchema} from '../../../lib/guides/schema';
const href=buildStarTransferWhatsappHref();
const photoIndices=[3,7,5,6,9,8,1];
---
<BaseLayout partnerWhatsappTracking={buildStarTransferWhatsappTrackingContext({municipalitySlug:null,municipalityName:'Zeeland',pagePath:article.path,pageType:'province'})} title={article.seoTitle} titleExact={true} description={article.metaDescription} canonical={article.canonical} preloadImage={article.heroImage.src} ogImage={`https://www.partybusnederland.nl${article.heroImage.src}`} pageWhatsapp={{href,label:'WhatsApp-aanvraag voor StarTransfer in Zeeland'}} regionalFooter={zeelandFooter} pageQuoteHref="/provincies/zeeland/#boek-je-rit" jsonLd={[buildArticleSchema({headline:article.h1,description:article.metaDescription,url:article.canonical,datePublished:'2026-10-12',dateModified:'2026-10-12',image:`https://www.partybusnederland.nl${article.heroImage.src}`}),buildBreadcrumbSchema([{label:'Home',href:'/'},{label:'Kennisbank',href:'/kennisbank/'},{label:article.h1,href:article.path}]),buildFaqPageSchema(article.faqs)]}>
<PhotoHeader title={article.h1} lead={article.lead} photo={starTransferPhotos[0]} eyebrow={article.eyebrow} breadcrumbs={[{label:'Home',href:'/'},{label:'Kennisbank',href:'/kennisbank/'},{label:'StarTransfer Zeeland'}]}><Button href="/provincies/zeeland/#boek-je-rit">Vraag je rit aan</Button><p class="date">Gepubliceerd op <time datetime="2026-10-12">12 oktober 2026</time> · Partybus Nederland</p></PhotoHeader>
<article class="blog section__inner">
{article.sections.map((section,index)=>{const photo=starTransferPhotos[photoIndices[index]];return <section id={section.id}><h2>{section.title}</h2><div class="story"><div>{section.paragraphs.map(text=><p>{text}</p>)}{section.moreLink&&<a href={section.moreLink.href} target={section.moreLink.href.startsWith('https')?'_blank':undefined} rel={section.moreLink.href.startsWith('https')?'noopener noreferrer':undefined}>{section.moreLink.label} →</a>}</div><figure><PartnerImage src={photo.src} alt={photo.alt} loading="lazy" sizes="(max-width:800px) 100vw, 500px" /><figcaption>{photo.alt}</figcaption></figure></div></section>})}
<section class="cta"><h2>{article.cta.title}</h2><p>Bekijk de bussen, kies je vertrekplaats en vraag de beschikbaarheid en prijs aan.</p><Button href="/provincies/zeeland/#boek-je-rit">Boek hier je rit vanuit Zeeland</Button><p><a href="/provincies/zeeland/festivals/">Bekijk alle festivalbestemmingen →</a></p></section><section><h2>Vertrekplaatsen in Zeeland</h2><div class="locations">{article.cityLinks.map(city=><a href={city.href}>{city.label} →</a>)}</div></section></article><GuideFaqList title="Vragen over de samenwerking" items={article.faqs} />
</BaseLayout>
<style>.blog{max-width:1150px;padding-block:1rem 3rem}.blog h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.2;max-width:27ch}.blog h2{font-size:clamp(1.6rem,3vw,2.35rem);line-height:1.3}.blog p{line-height:1.9}.lead{font-size:1.12rem;max-width:85ch}.date{font-size:.9rem}.logo{width:180px;height:auto;background:#151515;border-radius:.7rem;padding:.5rem;margin-block:1rem}figure{margin:0}.hero-photo{margin-top:1.5rem}.hero-photo img{width:100%;height:auto;max-height:580px;object-fit:cover;border-radius:1rem}.blog>section{margin-block:3rem;scroll-margin-top:calc(var(--header-height) + 1rem)}.story{display:grid;grid-template-columns:1.2fr 1fr;gap:2rem;align-items:start}.story img{width:100%;height:auto;border-radius:1rem;max-height:500px;object-fit:cover}figcaption{padding-top:.6rem;font-size:.85rem;line-height:1.6}.cta{padding:2rem;border:1px solid var(--color-primary-line);border-radius:1rem;background:var(--color-surface-alt)}.locations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}a{color:var(--color-primary)}@media(max-width:800px){.story{grid-template-columns:1fr}.locations{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:500px){.locations{grid-template-columns:1fr}}</style>
