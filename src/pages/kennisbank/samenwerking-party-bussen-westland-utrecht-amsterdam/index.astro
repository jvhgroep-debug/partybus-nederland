---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MasterKennisbankArticle from '../../../components/kennisbank/MasterKennisbankArticle.astro';
import { samenwerkingWestland as article } from '../../../data/kennisbank/articles/samenwerkingWestland';
import { buildPartyBussenWestlandWhatsappHref, partyBussenWestland } from '../../../data/partners/partyBussenWestland';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqPageSchema } from '../../../lib/guides/schema';
const socialImage = `https://www.partybusnederland.nl${article.heroImage.src}`;
const jsonLd = [
 buildArticleSchema({ headline: article.h1, description: article.metaDescription, url: article.canonical, datePublished: '2026-10-11', dateModified: '2026-10-11', image: socialImage }),
 buildBreadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Kennisbank', href: '/kennisbank/' }, { label: article.h1 }]),
 buildFaqPageSchema(article.faqs),
];
---
<BaseLayout title={article.seoTitle} titleExact={true} description={article.metaDescription} canonical={article.canonical} ogImage={socialImage} preloadImage={article.heroImage.src} jsonLd={jsonLd} pageWhatsapp={{ href: buildPartyBussenWestlandWhatsappHref('Utrecht / Amsterdam'), label: partyBussenWestland.publicProfile.whatsapp.ariaLabel }}>
 <MasterKennisbankArticle article={article} />
</BaseLayout>
