---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MasterKennisbankArticle from '../../components/kennisbank/MasterKennisbankArticle.astro';
import { regionalPlanningArticles } from '../../data/kennisbank/regionalPlanning';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqPageSchema } from '../../lib/guides/schema';

export function getStaticPaths() {
  return regionalPlanningArticles.map(item => ({ params: { planning: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const { article } = item;
const image = `https://www.partybusnederland.nl${article.heroImage.src}`;
const publishedAt = '2026-10-18';
const jsonLd = [
  buildArticleSchema({ headline: article.h1, description: article.metaDescription, url: article.canonical, image, datePublished: publishedAt, dateModified: publishedAt }),
  buildBreadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Kennisbank', href: '/kennisbank/' }, { label: article.h1 }]),
  buildFaqPageSchema(article.faqs),
];
---
<BaseLayout title={article.seoTitle} titleExact={true} description={article.metaDescription} canonical={article.canonical} ogImage={image} twitterImage={image} preloadImage={article.heroImage.src} jsonLd={jsonLd} pageQuoteHref={item.quoteHref} pageWhatsapp={{ href: item.whatsappHref, label: `WhatsApp ${item.partnerName}` }}>
  <MasterKennisbankArticle article={article} />
</BaseLayout>
