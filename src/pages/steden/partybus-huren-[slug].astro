---
import CityLayout from '../../layouts/CityLayout.astro';
import MasterCityTemplate from '../../components/cities/MasterCityTemplate.astro';
import PartyBussenWestlandCityTemplate from '../../components/cities/PartyBussenWestlandCityTemplate.astro';
import ZuidHollandPartnerCityTemplate from '../../components/cities/ZuidHollandPartnerCityTemplate.astro';
import { resolveCityHeroImage } from '../../lib/cityImages';
import { ALL_CITY_SLUGS, buildCityPageData } from '../../data/cities/pilotFactory';
import {
	buildPrestigeCoachServiceQuoteHref,
	buildPrestigeCoachServiceWhatsappHref,
	prestigeCoachService,
	resolvePrestigeCoachServiceCityMedia,
} from '../../data/partners/prestigeCoachService';
import {
	buildTourgoWhatsappHref,
	resolveTourgoCityMedia,
	tourgoPartybussen,
} from '../../data/partners/tourgoPartybussen';
import { applyTourgoMunicipalityCopy } from '../../data/partners/tourgoCityCopy';
import {
	buildPartyBussenWestlandWhatsappHref,
	partyBussenWestland,
	resolvePartyBussenWestlandCityMedia,
} from '../../data/partners/partyBussenWestland';
import { applyPartyBussenWestlandMunicipalityCopy } from '../../data/partners/partyBussenWestlandCityCopy';
import { isNoordBrabantMunicipalitySlug } from '../../data/provinces/noordBrabant';
import { isUtrechtMunicipalitySlug } from '../../data/provinces/utrecht';
import { isZuidHollandMunicipalitySlug } from '../../data/provinces/zuidHolland';
import {
	noordBrabantFooter,
	utrechtFooter,
	zuidHollandFooter,
} from '../../data/settings/regionalFooters';
import {
	buildNoordBrabantWhatsappTrackingContext,
	buildPartyBussenWestlandWhatsappTrackingContext,
	buildZuidHollandWhatsappTrackingContext,
} from '../../lib/partnerWhatsappTracking';

export function getStaticPaths() {
	/** Static city folders keep their own index.astro to preserve existing routes. */
	const STATIC_CITY_SLUGS = new Set(['amsterdam', 'rotterdam', 'breda']);
	return ALL_CITY_SLUGS.filter((slug) => !STATIC_CITY_SLUGS.has(slug)).map((slug) => ({
		params: { slug },
	}));
}

const { slug } = Astro.params;
if (!slug) {
	throw new Error('Missing city slug');
}

const generatedCity = buildCityPageData(slug);
if (!generatedCity) {
	throw new Error(`Unknown city: ${slug}`);
}

const isNoordBrabantPartnerCity = isNoordBrabantMunicipalitySlug(generatedCity.slug);
const isZuidHollandPartnerCity = isZuidHollandMunicipalitySlug(generatedCity.slug);
const isUtrechtPartnerCity = isUtrechtMunicipalitySlug(generatedCity.slug);
const city = isZuidHollandPartnerCity
	? applyTourgoMunicipalityCopy(generatedCity)
	: isUtrechtPartnerCity
		? applyPartyBussenWestlandMunicipalityCopy(generatedCity)
		: generatedCity;
const defaultHeroImage = resolveCityHeroImage(city.slug);
const heroImage = isNoordBrabantPartnerCity
	? resolvePrestigeCoachServiceCityMedia(city.slug).hero
	: isZuidHollandPartnerCity
		? resolveTourgoCityMedia(city.slug).hero
		: isUtrechtPartnerCity
			? resolvePartyBussenWestlandCityMedia(city.slug).hero
			: defaultHeroImage;
const partnerPageProps = isNoordBrabantPartnerCity
	? {
			pageWhatsapp: {
				href: buildPrestigeCoachServiceWhatsappHref(city.name),
				label: prestigeCoachService.publicProfile.whatsapp.ariaLabel,
			},
			pageQuoteHref: buildPrestigeCoachServiceQuoteHref(city.name, city.path),
			footerAttribution: prestigeCoachService.footerAttribution,
			regionalFooter: noordBrabantFooter,
			partnerWhatsappTracking: buildNoordBrabantWhatsappTrackingContext({
				municipalitySlug: city.slug,
				municipalityName: city.name,
				pagePath: city.path,
				pageType: 'municipality',
			}),
		}
	: isZuidHollandPartnerCity
		? {
				pageWhatsapp: {
					href: buildTourgoWhatsappHref(city.name),
					label: tourgoPartybussen.publicProfile.whatsapp.ariaLabel,
				},
				regionalFooter: zuidHollandFooter,
				partnerWhatsappTracking: buildZuidHollandWhatsappTrackingContext({
					municipalitySlug: city.slug,
					municipalityName: city.name,
					pagePath: city.path,
					pageType: 'municipality',
				}),
			}
		: isUtrechtPartnerCity
			? {
					pageWhatsapp: {
						href: buildPartyBussenWestlandWhatsappHref(city.name),
						label: partyBussenWestland.publicProfile.whatsapp.ariaLabel,
					},
					regionalFooter: utrechtFooter,
					partnerWhatsappTracking: buildPartyBussenWestlandWhatsappTrackingContext({
						municipalitySlug: city.slug,
						municipalityName: city.name,
						municipalityProvinceSlug: 'utrecht',
						pagePath: city.path,
						pageType: 'municipality',
					}),
				}
			: {};

const webPageLd = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: city.metaTitle,
	description: city.metaDescription,
	url: city.canonical,
	inLanguage: 'nl-NL',
	isPartOf: {
		'@type': 'WebSite',
		name: 'Partybus Nederland',
		url: 'https://www.partybusnederland.nl/',
	},
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.partybusnederland.nl/' },
		{ '@type': 'ListItem', position: 2, name: 'Steden', item: 'https://www.partybusnederland.nl/#steden' },
		{ '@type': 'ListItem', position: 3, name: city.h1, item: city.canonical },
	],
};

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: city.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const ogImage = `https://www.partybusnederland.nl${defaultHeroImage.src}`;
---

<CityLayout
	title={city.metaTitle}
	description={city.metaDescription}
	canonical={city.canonical}
	preloadImage={heroImage.src}
	ogTitle={city.metaTitle}
	ogDescription={city.metaDescription}
	ogUrl={city.canonical}
	ogImage={ogImage}
	twitterTitle={city.metaTitle}
	twitterDescription={city.metaDescription}
	twitterImage={ogImage}
	jsonLd={[webPageLd, breadcrumbLd, faqLd]}
	{...partnerPageProps}
>
	{
		isZuidHollandPartnerCity ? (
			<ZuidHollandPartnerCityTemplate city={city} />
		) : isUtrechtPartnerCity ? (
			<PartyBussenWestlandCityTemplate city={city} />
		) : (
			<MasterCityTemplate city={city} />
		)
	}
</CityLayout>
