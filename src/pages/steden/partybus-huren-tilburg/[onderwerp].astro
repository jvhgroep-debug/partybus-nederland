---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CityHero from '../../../components/cities/CityHero.astro';
import CityWhy from '../../../components/cities/CityWhy.astro';
import TilburgClusterAttention from '../../../components/cities/TilburgClusterAttention.astro';
import TilburgClusterInternalLinks from '../../../components/cities/TilburgClusterInternalLinks.astro';
import GuideFaqList from '../../../components/guides/GuideFaqList.astro';
import GuideCta from '../../../components/guides/GuideCta.astro';
import {
	getTilburgClusterPageSteden,
	tilburgClusterPagesSteden,
	TILBURG_CITY_HUB,
	TILBURG_QUOTE_PATH,
} from '../../../data/tilburg/clusterPagesSteden';
import { getTilburgClusterVisuals } from '../../../data/tilburg/clusterVisuals';
import { buildTilburgClusterNavLinks } from '../../../lib/tilburgClusterLinks';
import { resolveCityHeroImage } from '../../../lib/cityImages';
import { whatsapp } from '../../../data/settings/whatsapp';
import {
	buildBreadcrumbSchema,
	buildFaqPageSchema,
	buildWebPageSchema,
} from '../../../lib/guides/schema';

export function getStaticPaths() {
	return tilburgClusterPagesSteden.map((page) => ({
		params: { onderwerp: page.slug },
	}));
}

const { onderwerp } = Astro.params;
if (!onderwerp) throw new Error('Missing Tilburg cluster onderwerp');

const page = getTilburgClusterPageSteden(onderwerp);
if (!page) throw new Error(`Unknown Tilburg cluster page: ${onderwerp}`);

const visuals = getTilburgClusterVisuals(page.slug);
const navLinks = buildTilburgClusterNavLinks(page);
const heroImage = resolveCityHeroImage('tilburg');

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Partybus huren Tilburg', href: TILBURG_CITY_HUB },
	{ label: page.navLabel, href: page.path },
];

const jsonLd = [
	buildWebPageSchema({
		name: page.h1,
		description: page.description,
		url: page.canonical,
	}),
	buildBreadcrumbSchema(breadcrumbs),
	buildFaqPageSchema(page.faqs),
];
---

<BaseLayout
	title={page.title}
	description={page.description}
	canonical={page.canonical}
	titleExact={true}
	preloadImage={heroImage.src}
	ogTitle={page.title}
	ogDescription={page.description}
	ogUrl={page.canonical}
	twitterTitle={page.title}
	twitterDescription={page.description}
	jsonLd={jsonLd}
>
	<article class="tilburg-cluster-page">
		<div class="tilburg-cluster-page__hero-wrap">
			<nav class="tilburg-cluster-page__crumbs section__inner" aria-label="Broodkruimels">
				{
					breadcrumbs.map((item, index) => (
						<>
							{index > 0 && <span aria-hidden="true"> / </span>}
							{index === breadcrumbs.length - 1 ? (
								<span>{item.label}</span>
							) : (
								<a href={item.href}>{item.label}</a>
							)}
						</>
					))
				}
			</nav>

			<CityHero
				title={page.h1}
				subtitle={page.lead}
				image={heroImage.src}
				imageAlt={heroImage.alt}
				imageWidth={heroImage.width}
				imageHeight={heroImage.height}
				whatsappHref={whatsapp.href}
				primaryHref={TILBURG_QUOTE_PATH}
				trustItems={[
					'Gratis offertes vergelijken',
					'Snelle reactie via WhatsApp',
					'Door heel Nederland',
					'Vrijblijvend aanvragen',
				]}
			/>
		</div>

		<section class="section tilburg-cluster-page__practical" aria-labelledby="tilburg-content-title">
			<div class="section__inner tilburg-cluster-page__practical-grid">
				<div class="reveal">
					<p class="section__eyebrow">Praktische uitleg</p>
					<h2 id="tilburg-content-title" class="section__title">Zo regel je {page.navLabel.toLowerCase()}</h2>
					<div class="tilburg-cluster-page__content">
						{page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</div>
				<figure class="tilburg-cluster-page__visual reveal">
					<img
						src={visuals.secondaryImage}
						alt={visuals.secondaryImageAlt}
						width="1536"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</section>

		<CityWhy
			title={`Voordelen van ${page.navLabel.toLowerCase()}`}
			lead="Waarom groepen in Tilburg via Partybus Nederland vergelijken."
			items={visuals.benefits}
		/>

		<TilburgClusterAttention
			title={`Waar op letten bij ${page.navLabel.toLowerCase()}?`}
			items={visuals.attentionPoints}
		/>

		<TilburgClusterInternalLinks links={navLinks} />

		<GuideFaqList
			eyebrow="FAQ"
			title={`Veelgestelde vragen over ${page.navLabel.toLowerCase()}`}
			lead="Korte antwoorden die je helpen een scherpere offerteaanvraag te doen."
			items={page.faqs}
		/>

		<GuideCta
			title="Klaar om partybussen voor Tilburg te vergelijken?"
			lead="Vul je ritgegevens in en ontvang vrijblijvend voorstellen van passende aanbieders."
			primaryHref={TILBURG_QUOTE_PATH}
			primaryLabel="Naar het offerteformulier"
			showWhatsapp={false}
		/>
	</article>
</BaseLayout>

<style>
	.tilburg-cluster-page {
		position: relative;
		isolation: isolate;
	}

	.tilburg-cluster-page__hero-wrap {
		position: relative;
	}

	.tilburg-cluster-page__crumbs {
		position: absolute;
		top: calc(var(--header-height) + 0.65rem);
		left: 50%;
		transform: translateX(-50%);
		width: min(100% - 2rem, var(--content-max-width));
		z-index: 2;
		padding: 0;
		font-size: 0.88rem;
		color: rgba(255, 255, 255, 0.82);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);
	}

	.tilburg-cluster-page__crumbs a {
		color: var(--color-primary);
	}

	.tilburg-cluster-page__practical-grid {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3rem);
		align-items: start;
	}

	@media (min-width: 900px) {
		.tilburg-cluster-page__practical-grid {
			grid-template-columns: 1.15fr 0.85fr;
			align-items: center;
			gap: 3.25rem;
		}
	}

	.tilburg-cluster-page__content {
		display: grid;
		gap: 1rem;
		max-width: none;
	}

	.tilburg-cluster-page__content p {
		margin: 0;
		line-height: 1.75;
		color: color-mix(in srgb, var(--color-text) 92%, transparent);
	}

	.tilburg-cluster-page__visual {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-primary-line);
		box-shadow: var(--shadow-soft);
		aspect-ratio: 4 / 3;
		background: #111;
	}

	.tilburg-cluster-page__visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Keep hero actions and CTA above fixed overlays. */
	.tilburg-cluster-page :global(.city-hero__content),
	.tilburg-cluster-page :global(.city-hero__actions),
	.tilburg-cluster-page :global(.guide-cta__actions) {
		position: relative;
		z-index: 2;
	}

	@media (max-width: 640px) {
		.tilburg-cluster-page__crumbs {
			font-size: 0.82rem;
			top: calc(var(--header-height) + 0.45rem);
		}
	}
</style>
