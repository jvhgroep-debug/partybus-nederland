---
import CityLayout from '../../../layouts/CityLayout.astro';
import AmsterdamPartyBussenWestlandTemplate from '../../../components/cities/AmsterdamPartyBussenWestlandTemplate.astro';
import { amsterdamCity as amsterdamSource } from '../../../data/cities/amsterdam';
import {
	applyAmsterdamWestlandCopy,
	amsterdamWestlandMedia,
} from '../../../data/partners/amsterdamPartyBussenWestland';
import {
	buildPartyBussenWestlandWhatsappHref,
	partyBussenWestland,
} from '../../../data/partners/partyBussenWestland';
import { amsterdamFooter } from '../../../data/settings/regionalFooters';
import { resolveCityHeroImage } from '../../../lib/cityImages';
import { buildPartyBussenWestlandWhatsappTrackingContext } from '../../../lib/partnerWhatsappTracking';

const city = applyAmsterdamWestlandCopy(amsterdamSource);
const heroImage = amsterdamWestlandMedia.hero;
const originalHeroImage = resolveCityHeroImage(city.slug);

const webPageLd = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: city.metaTitle,
	description: city.metaDescription,
	url: city.canonical,
	inLanguage: 'nl-NL',
	isPartOf: {
		'@type': 'WebSite',
		name: 'Partybus Nederland',
		url: 'https://www.partybusnederland.nl/',
	},
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: 'https://www.partybusnederland.nl/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Steden',
			item: 'https://www.partybusnederland.nl/#steden',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: city.h1,
			item: city.canonical,
		},
	],
};

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: city.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};

const ogImage = `https://www.partybusnederland.nl${originalHeroImage.src}`;
---

<CityLayout
	title={city.metaTitle}
	description={city.metaDescription}
	canonical={city.canonical}
	preloadImage={heroImage.src}
	ogTitle={city.metaTitle}
	ogDescription={city.metaDescription}
	ogUrl={city.canonical}
	ogImage={ogImage}
	twitterTitle={city.metaTitle}
	twitterDescription={city.metaDescription}
	twitterImage={ogImage}
	jsonLd={[webPageLd, breadcrumbLd, faqLd]}
	pageWhatsapp={{
		href: buildPartyBussenWestlandWhatsappHref(city.name),
		label: partyBussenWestland.publicProfile.whatsapp.ariaLabel,
	}}
	regionalFooter={amsterdamFooter}
	partnerWhatsappTracking={buildPartyBussenWestlandWhatsappTrackingContext({
		municipalitySlug: 'amsterdam',
		municipalityName: 'Amsterdam',
		municipalityProvinceSlug: 'noord-holland',
		pagePath: '/steden/partybus-huren-amsterdam/',
		pageType: 'municipality',
	})}
>
	<AmsterdamPartyBussenWestlandTemplate city={amsterdamSource} />
</CityLayout>
