---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Button from '../../../../components/buttons/Button.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import GuideFaqList from '../../../../components/guides/GuideFaqList.astro';
import { amsterdamFestivals as festivals, amsterdamFestivalWhatsapp as festivalWhatsapp } from '../../../../data/festivals/amsterdam';
import { partyBussenWestlandLogo } from '../../../../data/partners/partyBussenWestland';
import { amsterdamFooter } from '../../../../data/settings/regionalFooters';
import { buildPartyBussenWestlandWhatsappTrackingContext } from '../../../../lib/partnerWhatsappTracking';
import { buildBreadcrumbSchema, buildFaqPageSchema, buildWebPageSchema } from '../../../../lib/guides/schema';
export function getStaticPaths() { return festivals.map(festival => ({params:{slug:festival.slug},props:{festival}})); }
import { amsterdamWestlandMedia } from '../../../../data/partners/amsterdamPartyBussenWestland';
const { festival } = Astro.props;
const title = `Partybus naar ${festival.name} vanuit Amsterdam | Party Bussen Westland`;
const description = `Boek groepsvervoer naar ${festival.name} of laat je ophalen vanaf het festivalterrein. Vraag je rit vanuit Amsterdam aan bij Party Bussen Westland.`;
const canonical = `https://www.partybusnederland.nl${festival.path}`;
const href = festivalWhatsapp(festival);
const faqs = [
 {question:`Kan Party Bussen Westland ons naar ${festival.name} brengen?`,answer:`Vraag de heenrit vanuit Amsterdam rechtstreeks bij Party Bussen Westland aan. Geef jullie vertrekadres, groepsgrootte en gewenste aankomsttijd door. Party Bussen Westland bevestigt beschikbaarheid, voertuig en de toegestane afzetzone.`},
 {question:`Kunnen we vanaf ${festival.name} worden opgehaald?`,answer:`Ja, je kunt een terugrit aanvragen vanaf een afgesproken ophaalpunt bij het festival. Geef ophaaldatum, tijd en bestemming door. De vervoerder bevestigt welk punt bereikbaar en toegestaan is.`},
 {question:'Hoe boeken we onze rit?',answer:'Klik op Boek hier je rit, vul de gegevens in het WhatsApp-bericht aan en verstuur je aanvraag. De rit is definitief nadat je met Party Bussen Westland de beschikbaarheid, prijs en boekingsvoorwaarden hebt afgesproken.'},
 {question:'Zijn tickets inbegrepen?',answer:'De aanvraag gaat over vervoer. Festivaltickets zijn niet automatisch inbegrepen. Koop toegang bij de organisator en spreek het vervoer rechtstreeks met Party Bussen Westland af.'},
];
const related = festivals.filter(item => item.slug !== festival.slug).sort((a,b)=>Number(b.province === festival.province)-Number(a.province === festival.province)).slice(0,6);
---
<BaseLayout title={title} titleExact={true} description={description} canonical={canonical} ogImage={`https://www.partybusnederland.nl${festival.hero.src}`} preloadImage={festival.hero.src} pageWhatsapp={{href,label:`Boek je rit voor ${festival.name} bij Party Bussen Westland`}} regionalFooter={amsterdamFooter} partnerWhatsappTracking={buildPartyBussenWestlandWhatsappTrackingContext({municipalitySlug:'amsterdam',municipalityName:'Amsterdam',municipalityProvinceSlug:'noord-holland',pagePath:festival.path,pageType:'municipality'})} jsonLd={[buildWebPageSchema({name:title,description,url:canonical}),buildBreadcrumbSchema([{label:'Home',href:'/'},{label:'Festivalvervoer',href:'/steden/partybus-huren-amsterdam/festivals/'},{label:festival.name,href:festival.path}]),buildFaqPageSchema(faqs)]}>
 <header class="festival-hero">
  <PartnerImage class="festival-hero__photo" src={festival.hero.src} alt={festival.hero.alt} loading="eager" fetchpriority="high" sizes="100vw" />
  <div class="section__inner"><nav aria-label="Broodkruimelnavigatie"><a href="/">Home</a> / <a href="/steden/partybus-huren-amsterdam/festivals/">Festivals</a> / <span aria-current="page">{festival.name}</span></nav><img class="partner-logo" src={partyBussenWestlandLogo} alt="Party Bussen Westland" width="1343" height="1132" /><p class="section__eyebrow">Onze vervoerspartner voor Amsterdam</p><h1>Partybus naar {festival.name} vanuit Amsterdam en terug</h1><p>Samen naar {festival.name} in {festival.location}, samen weer naar huis. Vraag jullie heenrit, terugrit of complete groepsreis aan bij Party Bussen Westland.</p><Button href={href} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="province-hero">Boek hier je rit</Button><p class="small">Aanvraag via WhatsApp · prijs en beschikbaarheid rechtstreeks afspreken</p></div>
 </header>
 <div class="section__inner content">
  {festival.date && <section><h2>Festivaldatum</h2><p>{festival.date}</p></section>}
  <section><h2>Met je groep vanuit Amsterdam naar {festival.name}</h2><p>Vertrekken jullie vanuit Amsterdam Centrum, Noord, West, Zuid, Oost of Zuidoost? Party Bussen Westland is onze partner voor groepsvervoer vanuit Amsterdam. Je kunt een partybusrit naar {festival.name} aanvragen en de terugreis direct meenemen in dezelfde afspraak.</p><p>{festival.tip}</p><p>Laat weten hoeveel mensen meegaan en of jullie één centraal opstappunt of meerdere adressen hebben. Party Bussen Westland bespreekt de route, het geschikte voertuig en de totaalprijs met jullie. Voor {festival.name} in {festival.province} wordt de bestemming afgestemd op de locatie van jullie gekozen editie.</p><a href={festival.source} target="_blank" rel="noopener noreferrer">Officiële informatie over {festival.name} ↗</a></section>
  <section><h2>Ophalen vanaf het festivalterrein van {festival.name}</h2><p>Wil je alleen vervoer terug? In het WhatsApp-bericht staat alvast dat jullie vanaf {festival.name} komen en bij het afgesproken festival-ophaalpunt opgehaald willen worden. Vul jullie tijd, aantal personen en bestemming in. Je kunt ook kiezen voor alleen de heenrit of heen en terug.</p><p>Spreek één bereikbaar verzamelpunt af met de chauffeur en houd een contactpersoon van de groep beschikbaar. Het ophaalpunt kan een aangewezen buszone buiten de festivalingang zijn; de toegang en terreinregels worden door de organisator bepaald.</p><div class="cards"><div><h3>Naar {festival.name}</h3><p>Vertrek vanuit jullie Amsterdamse opstapadres en stem de aankomsttijd af op jullie plannen.</p><Button href={festivalWhatsapp(festival,'Naar het festival')} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Boek de heenrit</Button></div><div><h3>Vanaf {festival.name}</h3><p>Laat je groep ophalen bij het afgesproken festivalpunt en terugbrengen naar jullie bestemming.</p><Button href={href} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Boek de terugrit</Button></div><div><h3>Heen en terug</h3><p>Regel beide ritten tegelijk, ook wanneer de terugrit op een andere dag plaatsvindt.</p><Button href={festivalWhatsapp(festival,'Heen en terug')} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Boek beide ritten</Button></div></div></section>
  <section><h2>De bus en sfeer van Party Bussen Westland</h2><p>Bekijk de bestaande partnerfoto’s van de bus en het interieur. Bespreek met Party Bussen Westland welke partybus past bij jullie groep en welke voorzieningen voor jullie rit beschikbaar zijn. Vraag welk voertuig, welke voorzieningen en hoeveel bagageruimte voor jullie rit beschikbaar zijn.</p><div class="photos">{amsterdamWestlandMedia.gallery.slice(0,6).map(photo=><figure><PartnerImage src={photo.src} alt={photo.alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:900px) 50vw, 33vw" /><figcaption>{photo.alt}</figcaption></figure>)}</div></section>
  <section><h2>Boek hier je rit voor {festival.name}</h2><p>Geef festivaldag, opstapadres, ophaaltijd, groepsgrootte en afzetadres door. Vermeld bij een weekendrit ook campingbagage en verschillende reisdata. Jullie ontvangen rechtstreeks van Party Bussen Westland de mogelijkheden en prijs; bevestig daarna de boeking met de vervoerder.</p><Button href={href} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Vraag je rit aan via WhatsApp</Button><p>Party Bussen Westland: <a href="tel:+31174352241">0174 352241</a>. Dit is een vervoersaanvraag bij onze Amsterdamse partner. Een festivalvermelding betekent geen officiële samenwerking met de festivalorganisator.</p></section>
  <section><h2>Meer festivalbestemmingen</h2><div class="links">{related.map(item=><a href={item.path}>Partybus naar {item.name} →</a>)}</div><p><a href="/steden/partybus-huren-amsterdam/festivals/">Bekijk alle festivals →</a> · <a href="/steden/partybus-huren-amsterdam/">Vervoer vanuit Amsterdam →</a></p></section>
 </div><GuideFaqList title={`Vragen over vervoer naar ${festival.name}`} items={faqs} />
</BaseLayout>
<style>
.festival-hero{position:relative;isolation:isolate;background:#141414;color:white;padding-block:calc(var(--header-height) + 2rem) 3rem}.festival-hero__photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.festival-hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.94),rgba(0,0,0,.7));z-index:-1}.festival-hero h1{font-size:clamp(2rem,5vw,3.8rem);line-height:1.15;max-width:23ch}.festival-hero p{max-width:65ch;line-height:1.8}.festival-hero nav{margin-bottom:1.5rem}.partner-logo{width:min(100%,340px);height:auto;margin-block:1.5rem}.small{font-size:.9rem}.content{padding-block:1rem 3rem}.content section{padding-block:2rem;border-bottom:1px solid var(--color-primary-line)}.content h2{font-size:clamp(1.6rem,3vw,2.5rem)}.content p{line-height:1.85}.cards,.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;margin-top:1.5rem}.cards>div{padding:1.4rem;border:1px solid var(--color-primary-line);border-radius:1rem}.cards h3{font-size:1.25rem}figure{margin:0}.photos img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:1rem}figcaption{font-size:.85rem;padding-top:.5rem}.links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}a{color:var(--color-primary)}@media(max-width:900px){.photos{grid-template-columns:repeat(2,minmax(0,1fr))}.cards{grid-template-columns:1fr}}@media(max-width:640px){.photos,.links{grid-template-columns:1fr}}
</style>
