---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import Intro from '../components/home/Intro.astro';
import DepartureRegions from '../components/home/DepartureRegions.astro';
import Services from '../components/home/Services.astro';
import PopularCities from '../components/home/PopularCities.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import OccasionsGuide from '../components/home/OccasionsGuide.astro';
import InfoGuide from '../components/shared/InfoGuide.astro';
import Reviews from '../components/home/Reviews.astro';
import FAQPreview from '../components/home/FAQPreview.astro';
import KnowledgeHub from '../components/home/KnowledgeHub.astro';
import CTA from '../components/home/CTA.astro';
import SafetyAndPartners from '../components/home/SafetyAndPartners.astro';
import { bookingTips, compareChecklist, pricingFactors } from '../data/guides/partybusInfo';
import { homeFaqs } from '../data/settings/faq-home';

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: homeFaqs.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Partybus Nederland',
	url: 'https://www.partybusnederland.nl/',
	description: 'Vergelijkingsplatform voor partybusverhuur in Nederland.',
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'customer service',
		availableLanguage: ['nl'],
	},
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Partybus Nederland',
	url: 'https://www.partybusnederland.nl/',
	inLanguage: 'nl-NL',
};
---

<BaseLayout
	title="Partybus huren | Vergelijk prijs, bus en ritvoorwaarden"
	description="Partybus of feestbus huren? Kies je vertrekplaats, bekijk prijsfactoren en plan de heen- en terugrit. Vraag gratis offertes aan voor jouw groep."
	titleExact={true}
	jsonLd={[organizationSchema, websiteSchema, faqSchema]}
>
	<Hero
		title="Partybus huren voor jouw groep"
		subtitle="Plan je vertrekplaats, groepsgrootte en terugrit. Vergelijk prijs, bus en voorwaarden voor jullie festival, feest of bedrijfsuitje — jij kiest zelf."
		image="/images/partybus-nederland-hero-feest.webp"
		imageWidth={1200}
		imageHeight={800}
		imagePosition="center 42%"
		secondaryHref="#werkwijze"
		secondaryLabel="Zo werkt vergelijken"
	/>
	<TrustBar />
	<Intro />
	<DepartureRegions />
	<HowItWorks />
	<Services />
	<SafetyAndPartners />
	<Reviews />
	<InfoGuide
		eyebrow="Prijzen & planning"
		title="Waar hangt de prijs van een partybus van af?"
		lead="Geen vaste landelijke tarieven. Wel heldere factoren waarmee je offertes eerlijk naast elkaar legt."
		cards={pricingFactors}
		checklist={compareChecklist}
	/>
	<PopularCities />
	<OccasionsGuide />
	<KnowledgeHub />
	<section class="section"><div class="section__inner"><h2>Welk vertrekadres past bij jullie groep?</h2><p>Twijfel je tussen twee verzamelpunten? <a href="/kennisbank/partybus-twee-vertrekadressen-vergelijken/">Vergelijk twee mogelijke vertrekadressen voor je partybus</a> en bereid één voorkeur voor die je door de vervoerder laat bevestigen.</p></div></section>
	<section class="section"><div class="section__inner"><h2>Samen de muziek voor je rit voorbereiden</h2><p>Wil je groep een eigen afspeellijst meenemen? <a href="/kennisbank/partybus-afspeellijst-muziek-voorbereiden/">Bereid de muziekkeuze en afspeelafspraak voor de partybus voor</a>: van gezamenlijke voorstellen tot één contactpersoon voor de lijst.</p></div></section>
	<section class="section"><div class="section__inner"><h2>Instappen en praktische vervoerswensen</h2><p>Heeft iemand in je groep een vraag over de instap of een hulpmiddel? <a href="/kennisbank/partybus-instappen-mobiliteitswensen-vooraf-bespreken/">Lees welke mobiliteitswensen je vóór de boeking bespreekt</a> en laat de vervoerder de aangeboden uitvoering bevestigen.</p></div></section>
	<InfoGuide
		eyebrow="Tips"
		title="Tips voor een geslaagde partybusrit"
		lead="Praktische aandachtspunten vóór je boekt — handig voor festivals, stedenritten en groepsfeesten."
		cards={bookingTips}
	/>
	<FAQPreview />
	<CTA />
</BaseLayout>
