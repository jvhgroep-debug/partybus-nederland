---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import { zuidHollandFestivals as festivals } from '../../../../data/festivals/zuidHolland';
import { tourgoPartybussenLogo, tourgoPartybussen } from '../../../../data/partners/tourgoPartybussen';
import { buildFestivalOverviewWhatsapp } from '../../../../data/festivals/overviewWhatsapp';
import FestivalWhatsappPicker from '../../../../components/festivals/FestivalWhatsappPicker.astro';
import { zuidHollandFooter } from '../../../../data/settings/regionalFooters';
const whatsappHref=buildFestivalOverviewWhatsapp(festivals,{name:tourgoPartybussen.publicProfile.name,phone:tourgoPartybussen.publicProfile.whatsapp.phone},'Zuid-Holland');
const title='Festivalvervoer vanuit Zuid-Holland | Tourgo Partybussen';
const description='Vind je festival en vraag vervoer vanuit Zuid-Holland aan bij Tourgo Partybussen. Heenrit, terugrit vanaf het festivalterrein of beide.';
---
<BaseLayout pageWhatsapp={{href:whatsappHref,label:tourgoPartybussen.publicProfile.whatsapp.ariaLabel}} regionalFooter={zuidHollandFooter} title={title} titleExact={true} description={description} canonical="https://www.partybusnederland.nl/provincies/zuid-holland/festivals/" ogImage={`https://www.partybusnederland.nl${festivals[0].hero.src}`}>
<div class="section__inner festival-hub"><img class="logo" src={tourgoPartybussenLogo} alt="Tourgo Partybussen" width="500" height="503" /><p class="section__eyebrow">Onze partner voor Zuid-Holland</p><h1>Partybus vanuit Zuid-Holland naar grote festivals</h1><p>Kies je festival en regel met Tourgo Partybussen de rit vanuit Zuid-Holland. Laat je brengen, ophalen vanaf het afgesproken festivalpunt of boek heen en terug. Op elke pagina staat het juiste festival alvast in je WhatsApp-aanvraag.</p><p><a href="/festivals/">Vertrek je vanuit Noord-Brabant? Bekijk Prestige Coach Service →</a></p><p><a href="/provincies/utrecht/festivals/">Vertrek je vanuit Utrecht? Bekijk Party Bussen Westland →</a></p><FestivalWhatsappPicker festivals={festivals} href={whatsappHref} /><p><a href="/steden/partybus-huren-amsterdam/festivals/">Vertrek je vanuit Amsterdam? Bekijk het Amsterdamse festivalvervoer →</a></p><p><a href="/provincies/zeeland/festivals/">Vertrek je vanuit Zeeland? Bekijk StarTransfer →</a></p><div class="grid">{festivals.map(festival=><a class="card" href={festival.path}><PartnerImage src={festival.hero.src} alt={festival.hero.alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:1000px) 50vw, 33vw" /><div><p>{festival.province} · {festival.location}</p><h2>{festival.name}</h2><p>{festival.tip}</p><strong>Boek hier je rit →</strong></div></a>)}</div><p><a href="/provincies/zuid-holland/">Bekijk onze partner en vertrekplaatsen in Zuid-Holland →</a></p></div>
</BaseLayout>
<style>.festival-hub{padding-block:calc(var(--header-height) + 2rem) 4rem}.logo{width:min(100%,340px);height:auto}.festival-hub h1{font-size:clamp(2rem,4vw,3.5rem)}.festival-hub>p{max-width:75ch;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-block:2rem}.card{display:block;text-decoration:none;border:1px solid var(--color-primary-line);border-radius:1rem;overflow:hidden;color:inherit}.card:hover,.card:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.card>div{padding:1.3rem}.card p{line-height:1.7}.card h2{font-size:1.6rem}.card strong{color:var(--color-primary)}@media(max-width:1000px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.grid{grid-template-columns:1fr}}</style>
