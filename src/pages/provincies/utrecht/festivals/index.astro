---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import { utrechtFestivals as festivals } from '../../../../data/festivals/utrecht';
import { partyBussenWestlandLogo, partyBussenWestland } from '../../../../data/partners/partyBussenWestland';
import { buildFestivalOverviewWhatsapp } from '../../../../data/festivals/overviewWhatsapp';
import FestivalWhatsappPicker from '../../../../components/festivals/FestivalWhatsappPicker.astro';
import { utrechtFooter } from '../../../../data/settings/regionalFooters';
const whatsappHref=buildFestivalOverviewWhatsapp(festivals,{name:partyBussenWestland.publicProfile.name,phone:partyBussenWestland.publicProfile.whatsapp.phone},'Utrecht');
const title='Festivalvervoer vanuit Utrecht | Party Bussen Westland';
const description='Vind je festival en vraag vervoer vanuit Utrecht aan bij Party Bussen Westland. Heenrit, terugrit vanaf het festivalterrein of beide.';
---
<BaseLayout pageWhatsapp={{href:whatsappHref,label:partyBussenWestland.publicProfile.whatsapp.ariaLabel}} regionalFooter={utrechtFooter} title={title} titleExact={true} description={description} canonical="https://www.partybusnederland.nl/provincies/utrecht/festivals/" ogImage={`https://www.partybusnederland.nl${festivals[0].hero.src}`}>
<div class="section__inner festival-hub"><img class="logo" src={partyBussenWestlandLogo} alt="Party Bussen Westland" width="1343" height="1132" /><p class="section__eyebrow">Onze partner voor Utrecht</p><h1>Partybus vanuit Utrecht naar grote festivals</h1><p>Kies je festival en regel met Party Bussen Westland de rit vanuit Utrecht. Laat je brengen, ophalen vanaf het afgesproken festivalpunt of boek heen en terug. Op elke pagina staat het juiste festival alvast in je WhatsApp-aanvraag.</p><p><a href="/festivals/">Vertrek je vanuit Noord-Brabant? Bekijk Prestige Coach Service →</a></p><FestivalWhatsappPicker festivals={festivals} href={whatsappHref} /><p><a href="/steden/partybus-huren-amsterdam/festivals/">Vertrek je vanuit Amsterdam? Bekijk het Amsterdamse festivalvervoer →</a></p><div class="grid">{festivals.map(festival=><a class="card" href={festival.path}><PartnerImage src={festival.hero.src} alt={festival.hero.alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:1000px) 50vw, 33vw" /><div><p>{festival.province} · {festival.location}</p><h2>{festival.name}</h2><p>{festival.tip}</p><strong>Boek hier je rit →</strong></div></a>)}</div><p><a href="/provincies/utrecht/">Bekijk onze partner en vertrekplaatsen in Utrecht →</a></p></div>
</BaseLayout>
<style>.festival-hub{padding-block:calc(var(--header-height) + 2rem) 4rem}.logo{width:min(100%,340px);height:auto}.festival-hub h1{font-size:clamp(2rem,4vw,3.5rem)}.festival-hub>p{max-width:75ch;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-block:2rem}.card{display:block;text-decoration:none;border:1px solid var(--color-primary-line);border-radius:1rem;overflow:hidden;color:inherit}.card:hover,.card:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.card>div{padding:1.3rem}.card p{line-height:1.7}.card h2{font-size:1.6rem}.card strong{color:var(--color-primary)}@media(max-width:1000px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.grid{grid-template-columns:1fr}}</style>
