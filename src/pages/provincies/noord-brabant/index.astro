---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProvincePageTemplate from '../../../components/provinces/ProvincePageTemplate.astro';
import {
	buildPrestigeCoachServiceWhatsappHref,
	prestigeCoachService,
} from '../../../data/partners/prestigeCoachService';
import {
	getNoordBrabantMunicipalities,
	noordBrabantProvince,
} from '../../../data/provinces/noordBrabant';
import {
	buildBreadcrumbSchema,
	buildFaqPageSchema,
	buildWebPageSchema,
} from '../../../lib/guides/schema';
import { buildNoordBrabantWhatsappTrackingContext } from '../../../lib/partnerWhatsappTracking';
import { noordBrabantFooter } from '../../../data/settings/regionalFooters';

const province = noordBrabantProvince;
const municipalities = getNoordBrabantMunicipalities();
const partner = prestigeCoachService;

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Noord-Brabant', href: province.path },
] as const;

const jsonLd = [
	buildWebPageSchema({
		name: province.h1,
		description: province.metaDescription,
		url: province.canonical,
	}),
	buildBreadcrumbSchema(breadcrumbs),
	buildFaqPageSchema(province.faqs),
];

const heroImage = partner.publicProfile.media.hero ?? province.heroImage;
const socialImage = `https://www.partybusnederland.nl${heroImage}`;
---

<BaseLayout
	title={province.title}
	description={province.metaDescription}
	canonical={province.canonical}
	titleExact={true}
	preloadImage={heroImage}
	ogTitle={province.title}
	ogDescription={province.metaDescription}
	ogUrl={province.canonical}
	ogImage={socialImage}
	twitterTitle={province.title}
	twitterDescription={province.metaDescription}
	twitterImage={socialImage}
	jsonLd={jsonLd}
	pageWhatsapp={{
		href: buildPrestigeCoachServiceWhatsappHref('Noord-Brabant'),
		label: partner.publicProfile.whatsapp.ariaLabel,
	}}
	pageQuoteHref="#offerte"
	footerAttribution={partner.footerAttribution}
	regionalFooter={noordBrabantFooter}
	partnerWhatsappTracking={buildNoordBrabantWhatsappTrackingContext({
		municipalitySlug: null,
		municipalityName: 'Noord-Brabant',
		pagePath: province.path,
		pageType: 'province',
	})}
>
	<section class="section__inner" style="padding-block:2rem"><h2>Boek je rit naar grote festivals</h2><p>Met Prestige Coach Service naar festivals in heel Nederland, of laat je ophalen vanaf het afgesproken festivalterrein.</p><a href="/festivals/">Kies je festival en boek hier je rit →</a></section>
	<ProvincePageTemplate municipalities={municipalities} />
</BaseLayout>
