---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import Button from '../../../../components/buttons/Button.astro';
import GuideFaqList from '../../../../components/guides/GuideFaqList.astro';
import { prestigeCoachService, prestigeCoachServiceLogo, prestigeCoachServiceCityMedia, buildPrestigeCoachServiceWhatsappHref, buildPrestigeCoachServiceQuoteHref } from '../../../../data/partners/prestigeCoachService';
import { brabantFestivals, brabantFestivalGuidePath } from '../../../../data/provinces/brabantFestivals';
import { noordBrabantFooter } from '../../../../data/settings/regionalFooters';
import { buildNoordBrabantWhatsappTrackingContext } from '../../../../lib/partnerWhatsappTracking';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqPageSchema } from '../../../../lib/guides/schema';
const title = 'Partybus Brabant: Prestige & festivals 2026–2027';
const description = 'Ontdek Prestige Coach Service, partnerfoto’s en festivaldatums voor 2026 en 2027 in en rond Noord-Brabant. Vraag direct partybusvervoer aan.';
const canonical = `https://www.partybusnederland.nl${brabantFestivalGuidePath}`;
function festivalWhatsappHref(selectedFestival = '') {
 const href = new URL(buildPrestigeCoachServiceWhatsappHref('Noord-Brabant'));
 const message = [
  'Goedendag Prestige Coach Service,', '',
  'Ik kom via PartybusNederland.nl en wil graag festivalvervoer boeken of een offerte aanvragen.', '',
  `Festival waarvoor ik vervoer wil boeken: ${selectedFestival}`,
  `Festivals op de pagina: ${brabantFestivals.map(festival => festival.name).join(' / ')}`,
  'Ander festival (naam): ',
  'Festivaleditie / jaar: ',
  'Gewenste datum / festivaldag: ',
  'Mijn naam: ',
  'Aantal personen: ',
  'Welke rit? Naar het festival / vanaf het festivalterrein / heen en terug: ',
  'Vertrekken of opgehaald worden vanaf het festivalterrein? Ja / nee: ',
  'Naam festivalterrein / afgesproken ophaalzone: ',
  'Vertrekplaats / exact opstapadres bij de heenrit: ',
  'Gewenste vertrektijd heenrit: ',
  'Gewenste aankomsttijd bij het festival: ',
  'Ophaaldatum en tijd vanaf het festivalterrein: ',
  'Bestemming / afzetadres na het festival: ',
  'Eventuele tussenstops: ',
  'Bagage / catering / extra wensen: ', '',
  'Kunt u de beschikbaarheid, het voertuig, het geschikte ophaalpunt en de totaalprijs bevestigen?',
 ].join('\n');
 href.searchParams.set('text', message);
 return href.toString();
}
const whatsappHref = festivalWhatsappHref();
const quoteHref = buildPrestigeCoachServiceQuoteHref('Noord-Brabant', brabantFestivalGuidePath);
const hero = prestigeCoachServiceCityMedia.desktopHeroes[0];
const faqs = [
 { question: 'Wat is de capaciteit van de eigen limobus van Prestige?', answer: 'Prestige vermeldt een eigen 24-persoons XXL Mercedes Sprinter. Via externe vervoerspartners worden ook andere voertuigen aangeboden. Vraag welk voertuig en welke capaciteit voor jullie rit worden bevestigd.' },
 { question: 'Zijn alle festivaldatums voor 2027 bekend?', answer: 'Nee. De tabel bevat alleen datums die op 12 oktober 2026 in de gecontroleerde officiële bronnen staan. Bij WiSH en Tomorrowland Belgium is de datum voor 2027 in die bronnen nog niet bevestigd.' },
 { question: 'Zijn de genoemde festivals van 2026 nog te boeken?', answer: 'De vermelde festivaledities van 2026 zijn verstreken. Ze staan hier als terugblik en om de edities te onderscheiden. Voor een toekomstige rit kies je een bevestigde toekomstige festivaldatum.' },
 { question: 'Zijn festivaltickets inbegrepen bij het vervoer?', answer: 'Deze pagina biedt een aanvraag voor vervoer. Festivaltickets zijn niet automatisch inbegrepen. Controleer tickets bij de organisator en spreek vervoer, prijs en voorwaarden rechtstreeks met Prestige af.' },
 { question: 'Kan de partybus bij de ingang stoppen?', answer: 'Dat hangt af van de regels van het festival. Bespreek busregistratie, de toegestane afzetzone en het ophaalpunt met de vervoerder. Een festivaladres is niet automatisch de juiste bushalte.' },
];
const jsonLd = [buildArticleSchema({ headline: 'Partybus in Noord-Brabant: Prestige Coach Service en festivals 2026–2027', description, url: canonical, datePublished: '2026-10-12', dateModified: '2026-10-12', image: `https://www.partybusnederland.nl${hero.src}` }), buildBreadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Noord-Brabant', href: '/provincies/noord-brabant/' }, { label: 'Festivals 2026–2027', href: brabantFestivalGuidePath }]), buildFaqPageSchema(faqs)];
---
<BaseLayout title={title} titleExact={true} description={description} canonical={canonical} ogImage={`https://www.partybusnederland.nl${hero.src}`} preloadImage={hero.src} jsonLd={jsonLd} pageWhatsapp={{ href: whatsappHref, label: 'WhatsApp Prestige Coach Service' }} pageQuoteHref={quoteHref} regionalFooter={noordBrabantFooter} partnerWhatsappTracking={buildNoordBrabantWhatsappTrackingContext({ municipalitySlug: null, municipalityName: 'Noord-Brabant', pagePath: brabantFestivalGuidePath, pageType: 'province' })}>
 <article class="festival-guide">
  <header class="festival-hero">
   <PartnerImage class="festival-hero__photo" src={hero.src} alt={hero.alt} loading="eager" fetchpriority="high" sizes="100vw" />
   <div class="section__inner festival-hero__copy"><nav aria-label="Broodkruimelnavigatie"><a href="/">Home</a> / <a href="/provincies/noord-brabant/">Noord-Brabant</a> / <span aria-current="page">Festivalgids</span></nav><img class="partner-logo" src={prestigeCoachServiceLogo} alt="Prestige Coach Service" width="1015" height="194" /><p class="section__eyebrow">Onze partner in heel Noord-Brabant</p><h1>Partybus in Noord-Brabant: Prestige Coach Service en festivals 2026–2027</h1><p>Ontdek het vervoer van onze Brabantse partner, bekijk de bestaande busfoto’s en plan jullie festivalrit met de officiële datums.</p><div class="actions"><Button href={whatsappHref} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="province-hero">Vraag Prestige via WhatsApp</Button><Button href="#festivalagenda" variant="ghost">Bekijk festivaldatums</Button></div></div>
  </header>
  <div class="section__inner festival-content">
   <section aria-labelledby="partner"><h2 id="partner">Wat biedt Prestige Coach Service aan?</h2><p>Prestige Coach Service, ook bekend via Limobus.nl, is onze partner voor heel Noord-Brabant en is gevestigd in Baarle-Nassau. Je kunt vervoer aanvragen vanuit onder meer Breda, Tilburg, Eindhoven, ’s-Hertogenbosch en de overige Brabantse gemeenten.</p><div class="service-grid">
    <div><h3>Eigen 24-persoons limobus</h3><p>De eigen XXL Mercedes Sprinter is geschikt voor maximaal 24 personen. Het voertuig kan als VIP-bus of partybus worden ingezet.</p></div>
    <div><h3>Partyvervoer</h3><p>Voor festivals, concerten, vrijgezellenfeesten, verjaardagen, bruiloften en groepsuitjes. Prestige beschrijft VIP-stoelen, muziek, ledverlichting en een drankvoorziening. Spreek het arrangement en de inbegrepen onderdelen af.</p></div>
    <div><h3>Zakelijk en VIP-vervoer</h3><p>Voor zakelijke ritten en evenementen biedt Prestige onder meer een tafelopstelling, presentatieschermen en wifi aan. Bevestig welke uitvoering en voorzieningen jullie krijgen.</p></div>
    <div><h3>Grotere groepen en catering</h3><p>Via externe vervoerspartners biedt Prestige ook grotere touringcars, minibussen en extra partybussen aan, waaronder een uitvoering tot 50 personen. Catering is op aanvraag tegen meerprijs mogelijk. Capaciteit en beschikbaarheid verschillen per voertuig.</p></div>
   </div><p class="sources">Aanbod controleren: <a href="https://limobus.nl/wagenpark" target="_blank" rel="noopener noreferrer">wagenpark</a> · <a href="https://limobus.nl/over-ons/partyvervoer" target="_blank" rel="noopener noreferrer">partyvervoer</a> · <a href="https://limobus.nl/over-ons/vipvervoer" target="_blank" rel="noopener noreferrer">VIP-vervoer</a> · <a href="https://limobus.nl/over-ons/catering" target="_blank" rel="noopener noreferrer">catering</a>.</p></section>
   <section aria-labelledby="fotos"><h2 id="fotos">Foto’s van onze partner</h2><p>Bekijk de bus, het interieur en de feestelijke sfeer op de bestaande partnerfoto’s. Het voertuig voor jullie datum wordt door Prestige bevestigd.</p><div class="photo-grid">{prestigeCoachServiceCityMedia.gallery.map(photo => <figure><PartnerImage src={photo.src} alt={photo.alt} loading="lazy" sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" /><figcaption>{photo.alt}</figcaption></figure>)}</div></section>
   <section aria-labelledby="festivalagenda"><h2 id="festivalagenda">Festivalagenda in en rond Brabant: 2026 en 2027</h2><p>Gecontroleerd op <time datetime="2026-10-12">12 oktober 2026</time>. De genoemde edities van <strong>2026 zijn verstreken</strong> en staan hier als terugblik. Voor 2027 tonen we bevestigde datums of vermelden we dat de datum in de gecontroleerde bron ontbreekt. Dit is een selectie, geen volledige festivalagenda.</p><div class="table-scroll" role="region" aria-label="Festivaldatums 2026 en 2027" tabindex="0"><table><caption>Officiële festivaldatums en locaties per editie</caption><thead><tr><th scope="col">Festival & locatie</th><th scope="col">2026 · verstreken</th><th scope="col">2027</th></tr></thead><tbody>{brabantFestivals.map(festival => <tr><th scope="row">{festival.name}<span>{festival.location}</span></th><td>{festival.date2026}<a href={festival.source2026} target="_blank" rel="noopener noreferrer">Bron 2026 ↗</a></td><td>{festival.date2027}<span class:list={['date-status', !festival.confirmed2027 && 'date-status--pending']}>{festival.confirmed2027 ? 'Datum bevestigd' : 'Datum nog controleren'}</span><a href={festival.source2027} target="_blank" rel="noopener noreferrer">Organisator / bron 2027 ↗</a></td></tr>)}</tbody></table></div><div class="festival-notes">{brabantFestivals.map(festival => <div><h3>{festival.name}: jullie rit plannen</h3><p>{festival.note}</p><Button href={festivalWhatsappHref(festival.name)} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Vervoer voor {festival.name} aanvragen</Button></div>)}</div><p>De organisatoren kunnen informatie wijzigen. Controleer vóór boeking de festivaldatum, toegangsvoorwaarden en vervoersinformatie op hun eigen website. De vermelding van een festival betekent geen samenwerking met die organisator.</p></section>
   <section><h2>Heenrit, terugrit en festivaltoegang afspreken</h2><p>Geef de gewenste festivaldag, het aantal personen en alle opstapadressen door. Bij campingvervoer kunnen heenrit en terugrit op verschillende dagen vallen. Spreek af hoeveel ruimte voor bagage nodig is en waar jullie na afloop verzamelen.</p><p>Laat Prestige de actuele regels voor touringcars, registratie en afzetzones controleren. De festivalorganisator bepaalt de toegang tot het terrein; de vervoerder bevestigt de haalbare route. Het vervoer en eventuele tickets zijn afzonderlijke afspraken.</p><ul><li>Festivalnaam, editie en gekozen dag of weekend.</li><li>Groepsgrootte en exacte vertrekplaats in Brabant.</li><li>Gewenste aankomsttijd, terugrit en tussenstops.</li><li>Bagage, voorzieningen en eventuele cateringwensen.</li></ul><div class="actions"><Button href={whatsappHref} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Bespreek jullie rit via WhatsApp</Button><Button href={quoteHref} variant="ghost">Aanvraag naar Prestige sturen</Button></div><p>De WhatsApp-knop opent direct het eigen nummer van Prestige: <a href="tel:+31629041798">06 2904 1798</a>. In het bericht staan de festivalnamen en vragen voor vervoer naar of vanaf het festivalterrein. Gebruik de knop bij een festival om die naam alvast in te vullen. Vul jullie datum en ophaalgegevens aan en verstuur het bericht zelf. Prijs, voertuig, boeking en betaling spreek je rechtstreeks met Prestige af.</p></section>
   <nav aria-label="Meer over Brabant"><a href="/provincies/noord-brabant/">Alle Brabantse gemeenten en aanvragen →</a><br /><a href="/kennisbank/samenwerking-prestige-coach-service-noord-brabant/">Lees over onze samenwerking met Prestige →</a></nav>
  </div>
  <GuideFaqList title="Vragen over Prestige en festivalvervoer in Brabant" items={faqs} />
 </article>
</BaseLayout>
<style>
.festival-hero { position: relative; isolation: isolate; background: #141414; color: white; padding-block: calc(var(--header-height) + 2rem) 4rem; }
.festival-hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
.festival-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.92), rgba(0,0,0,.68)); z-index: -1; }
.festival-hero__copy { position: relative; } .festival-hero h1 { max-width: 20ch; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.12; } .festival-hero p { max-width: 65ch; line-height: 1.7; } .festival-hero nav { font-size: .9rem; margin-bottom: 1.5rem; } .partner-logo { display: block; width: min(100%, 340px); height: auto; padding: .7rem; background: #141414; border-radius: .5rem; }
.festival-content { padding-block: 1rem 4rem; } .festival-content section { padding-block: 2.5rem; border-bottom: 1px solid var(--color-primary-line); } .festival-content h2 { font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.2; } .festival-content p, li { line-height: 1.8; } a { color: var(--color-primary); } .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1.5rem; } .service-grid, .festival-notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; } .service-grid>div { padding: 1.5rem; border: 1px solid var(--color-primary-line); border-radius: 1rem; } .sources { font-size: .9rem; }
.photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.3rem; } figure { margin: 0; } figure img { width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; border-radius: 1rem; } figcaption { padding-top: .6rem; font-size: .9rem; }
.table-scroll { overflow-x: auto; margin-block: 2rem; border: 1px solid var(--color-primary-line); border-radius: 1rem; } table { width: 100%; border-collapse: collapse; min-width: 650px; } caption { text-align: left; padding: 1rem; font-weight: 700; } th,td { text-align: left; vertical-align: top; padding: 1.2rem; border-top: 1px solid var(--color-primary-line); line-height: 1.65; } thead { background: var(--color-surface-alt); } td a,th span { display: block; font-size: .85rem; margin-top: .5rem; } th span { font-weight: 400; } .date-status { display: block; font-size: .85rem; font-weight: 700; margin-block: .5rem; } .date-status--pending { font-weight: 400; } .festival-content nav { padding-top: 2rem; line-height: 2; } section[id],h2[id] { scroll-margin-top: calc(var(--header-height) + 1rem); }
@media(max-width:900px) { .photo-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } } @media(max-width:640px) { .photo-grid { grid-template-columns: 1fr; } .festival-hero h1 { max-width: 100%; } }
</style>
