---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import { zeelandFestivals as festivals } from '../../../../data/festivals/zeeland';
import { starTransferLogo,starTransfer,zeelandFooter } from '../../../../data/partners/starTransfer';
import { buildFestivalOverviewWhatsapp } from '../../../../data/festivals/overviewWhatsapp';
import FestivalWhatsappPicker from '../../../../components/festivals/FestivalWhatsappPicker.astro';

const whatsappHref=buildFestivalOverviewWhatsapp(festivals,{name:starTransfer.publicProfile.name,phone:starTransfer.publicProfile.whatsapp.phone},'Zeeland');
import FestivalFeeling from '../../../../components/startransfer/FestivalFeeling.astro';
const title='Festivalvervoer vanuit Zeeland | StarTransfer';
const description='Vind je festival en vraag vervoer vanuit Zeeland aan bij StarTransfer. Heenrit, terugrit vanaf het festivalterrein of beide.';
---
<BaseLayout pageWhatsapp={{href:whatsappHref,label:starTransfer.publicProfile.whatsapp.ariaLabel}} regionalFooter={zeelandFooter} title={title} titleExact={true} description={description} canonical="https://www.partybusnederland.nl/provincies/zeeland/festivals/" ogImage={`https://www.partybusnederland.nl${festivals[0].hero.src}`}>
<div class="section__inner festival-hub"><img class="logo" src={starTransferLogo} alt="StarTransfer"  /><p class="section__eyebrow">Onze partner voor Zeeland</p><h1>Partybus vanuit Zeeland naar grote festivals</h1><p>Kies je festival en regel met StarTransfer de rit vanuit Zeeland. Laat je brengen, ophalen vanaf het afgesproken festivalpunt of boek heen en terug. Op elke pagina staat het juiste festival alvast in je WhatsApp-aanvraag.</p><p><a href="/festivals/">Vertrek je vanuit Noord-Brabant? Bekijk Prestige Coach Service →</a></p><p><a href="/provincies/utrecht/festivals/">Vertrek je vanuit Utrecht? Bekijk Party Bussen Westland →</a></p><FestivalWhatsappPicker festivals={festivals} href={whatsappHref} /><p><a href="/steden/partybus-huren-amsterdam/festivals/">Vertrek je vanuit Amsterdam? Bekijk het Amsterdamse festivalvervoer →</a></p><FestivalFeeling /><p><a href="/kennisbank/samenwerking-startransfer-zeeland/">Lees onze blog over de samenwerking met StarTransfer →</a></p><div class="grid">{festivals.map(festival=><a class="card" href={festival.path}><PartnerImage src={festival.hero.src} alt={festival.hero.alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:1000px) 50vw, 33vw" /><div><p>{festival.province} · {festival.location}</p><h2>{festival.name}</h2><p>{festival.tip}</p><strong>Boek hier je rit →</strong></div></a>)}</div><p><a href="/provincies/zeeland/">Bekijk StarTransfer en de vertrekplaatsen in Zeeland →</a></p></div>
</BaseLayout>
<style>.festival-hub{padding-block:calc(var(--header-height) + 2rem) 4rem}.logo{width:min(100%,340px);height:auto}.festival-hub h1{font-size:clamp(2rem,4vw,3.5rem)}.festival-hub>p{max-width:75ch;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-block:2rem}.card{display:block;text-decoration:none;border:1px solid var(--color-primary-line);border-radius:1rem;overflow:hidden;color:inherit}.card:hover,.card:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.card>div{padding:1.3rem}.card p{line-height:1.7}.card h2{font-size:1.6rem}.card strong{color:var(--color-primary)}@media(max-width:1000px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.grid{grid-template-columns:1fr}}</style>
