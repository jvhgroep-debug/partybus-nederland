---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PartnerImage from '../../../../components/shared/PartnerImage.astro';
import Button from '../../../../components/buttons/Button.astro';
import PhotoHeader from '../../../../components/startransfer/PhotoHeader.astro';
import FestivalFeeling from '../../../../components/startransfer/FestivalFeeling.astro';
import FestivalWhatsappPicker from '../../../../components/festivals/FestivalWhatsappPicker.astro';
import {zeelandFestivals as festivals} from '../../../../data/festivals/zeeland';
import {starTransfer,starTransferHeaderPhotos,starTransferPhotos,zeelandFooter} from '../../../../data/partners/starTransfer';
import {buildFestivalOverviewWhatsapp} from '../../../../data/festivals/overviewWhatsapp';
const whatsappHref=buildFestivalOverviewWhatsapp(festivals,{name:starTransfer.publicProfile.name,phone:starTransfer.publicProfile.whatsapp.phone},'Zeeland');
const title='Festivalvervoer vanuit Zeeland | StarTransfer';
const description='Vind je festival en vraag vervoer vanuit Zeeland aan bij StarTransfer. Heenrit, terugrit vanaf het festivalterrein of beide.';
const lead='Kies je festival en regel met StarTransfer de rit vanuit Zeeland. Laat je brengen, ophalen vanaf het afgesproken festivalpunt of boek heen en terug. Op elke pagina staat het juiste festival alvast in je WhatsApp-aanvraag.';
---
<BaseLayout pageWhatsapp={{href:whatsappHref,label:starTransfer.publicProfile.whatsapp.ariaLabel}} regionalFooter={zeelandFooter} title={title} titleExact={true} description={description} canonical="https://www.partybusnederland.nl/provincies/zeeland/festivals/" ogImage={`https://www.partybusnederland.nl${starTransferHeaderPhotos[3].src}`} preloadImage={starTransferHeaderPhotos[3].src}>
<PhotoHeader title="Partybus vanuit Zeeland naar grote festivals" lead={lead} photo={starTransferHeaderPhotos[3]} breadcrumbs={[{label:'Home',href:'/'},{label:'Zeeland',href:'/provincies/zeeland/'},{label:'Festivalvervoer'}]}><Button href="#kies-je-festival">Kies je festival</Button><Button href={whatsappHref} target="_blank" rel="noopener noreferrer" variant="ghost">Vraag via WhatsApp</Button></PhotoHeader>
<div class="section__inner festival-hub"><section id="kies-je-festival"><FestivalWhatsappPicker festivals={festivals} href={whatsappHref} /></section><FestivalFeeling /><p><a href="/kennisbank/samenwerking-startransfer-zeeland/">Lees onze blog over de samenwerking met StarTransfer →</a></p><div class="grid">{festivals.map((festival,index)=><a class="card" href={festival.path}><PartnerImage src={starTransferPhotos[index%starTransferPhotos.length].src} alt={starTransferPhotos[index%starTransferPhotos.length].alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:1000px) 50vw, 33vw" /><div><p>{festival.province} · {festival.location}</p><h2>{festival.name}</h2><p>{festival.tip}</p><strong>Boek hier je rit →</strong></div></a>)}</div><p><a href="/provincies/zeeland/">Bekijk StarTransfer en de vertrekplaatsen in Zeeland →</a></p><nav aria-label="Andere vertrekregio’s"><a href="/festivals/">Noord-Brabant</a> · <a href="/provincies/zuid-holland/festivals/">Zuid-Holland</a> · <a href="/provincies/utrecht/festivals/">Utrecht</a> · <a href="/steden/partybus-huren-amsterdam/festivals/">Amsterdam</a></nav></div>
</BaseLayout>
<style>.festival-hub{padding-block:2rem 4rem}.festival-hub p{line-height:1.8}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-block:2rem}.card{display:block;text-decoration:none;border:1px solid var(--color-primary-line);border-radius:1rem;overflow:hidden;color:inherit}.card:hover,.card:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}.card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.card>div{padding:1.3rem}.card p{line-height:1.7}.card h2{font-size:1.6rem}.card strong,a{color:var(--color-primary)}#kies-je-festival{scroll-margin-top:calc(var(--header-height) + 1rem)}@media(max-width:1000px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.grid{grid-template-columns:1fr}}</style>
