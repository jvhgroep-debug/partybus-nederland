<!doctype html><html lang="nl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>WhatsApp-statistieken | Partybus Nederland</title></head><body><main><header><a href="/">Partybus Nederland</a><h1>WhatsApp-statistieken</h1><p>Alle partners · historische klikken en nieuwe resultaten</p></header><section id="login"><h2>Jouw privé-overzicht</h2><p>Ontvang een inloglink op info@starlocal.nl. Die is 24 uur geldig.</p><button id="login-button">Stuur mijn inloglink</button></section><p id="status" role="status" aria-live="polite"></p><section id="dashboard" hidden><div class="toolbar"><button id="logout">Uitloggen</button><button id="csv">Download CSV per pagina</button></div><form id="filters"><label>Partner<select name="partner"><option value="">Alle partners</option><option value="prestige-coach-service">Prestige Coach Service</option><option value="tourgo">Tourgo Partybussen</option><option value="party-bussen-westland">Party Bussen Westland</option><option value="startransfer">StarTransfer</option><option value="tc-specialistische-reiniging">TC Specialistische Reiniging · SchoonVakmannen</option></select></label><label>Regio<select name="region"><option value="">Alle regio’s</option><option value="noord-brabant">Noord-Brabant</option><option value="zuid-holland">Zuid-Holland</option><option value="utrecht">Utrecht</option><option value="noord-holland">Amsterdam</option><option value="zeeland">Zeeland</option><option value="limburg">Limburg</option><option value="noord-brabant-limburg">Noord-Brabant en Limburg · algemeen</option></select></label><label>Vanaf<input name="start" type="date"/></label><label>Tot en met<input name="end" type="date"/></label><button>Toon resultaten</button></form><div class="toolbar"><button data-period="7">Laatste 7 dagen</button><button data-period="30">Laatste 30 dagen</button><button data-period="all">Alle opgeslagen historie</button></div><div class="cards"><article><span>WhatsApp-klikken</span><strong id="total">0</strong></article><article><span>Eerste klik in selectie</span><strong id="first">—</strong></article><article><span>Laatste klik in selectie</span><strong id="last">—</strong></article></div><p class="note">Dit zijn klikken op de WhatsApp-knop, geen verstuurde berichten, unieke bezoekers of bevestigde boekingen. Meerdere klikken van één bezoeker kunnen meetellen. Gegevens vóór de invoering van de meting zijn niet beschikbaar. Datums worden in UTC getoond.</p><h2>Per vervoerder en regio</h2><div class="table"><table><thead><tr><th>Partner</th><th>Regio</th><th>Klikken</th></tr></thead><tbody id="partners"></tbody></table></div><h2>Per pagina</h2><div class="table"><table><thead><tr><th>Partner</th><th>Pagina / plaats</th><th>Klikken</th></tr></thead><tbody id="pages"></tbody></table></div><h2>Per dag</h2><div class="table"><table><thead><tr><th>Dag (UTC)</th><th>Klikken</th></tr></thead><tbody id="days"></tbody></table></div><h2>Beschikbare historie per partner</h2><p>De eerste geregistreerde klik is geen bewijs van de datum waarop de meting werd ingeschakeld. Zonder klikken is er nog geen historie zichtbaar.</p><div class="table"><table><thead><tr><th>Partner</th><th>Eerste opgeslagen klik</th><th>Totaal sinds eerste klik</th></tr></thead><tbody id="coverage"></tbody></table></div></section></main></body></html>
<style is:global>body{margin:0;background:#f3f5f8;color:#152235;font:16px/1.6 system-ui,sans-serif}main{max-width:1100px;margin:auto;padding:28px 20px 70px}header{padding:25px;background:#14263c;color:white;border-radius:16px}header a{color:#b9ddff}h1{font-size:clamp(28px,5vw,40px);margin:14px 0 4px}h2{margin-top:30px}button,input,select{font:inherit;min-height:44px;border:1px solid #b8c3cf;border-radius:8px;padding:8px 12px;box-sizing:border-box}button{background:#176148;color:white;border:0;cursor:pointer}button:disabled{opacity:.6}label{display:grid;gap:4px}form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;background:white;padding:20px;border-radius:12px}.toolbar{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.cards article{padding:20px;background:white;border-radius:12px}.cards strong{display:block;font-size:24px}.note{background:#e1ecf7;padding:18px;border-radius:12px}.table{overflow:auto;background:white;border-radius:12px}table{border-collapse:collapse;width:100%;text-align:left}td,th{padding:12px 16px;border-bottom:1px solid #e6eaf0}th{background:#e8edf3}td a{color:#185793;overflow-wrap:anywhere}#status{min-height:24px}[hidden]{display:none!important}@media(max-width:650px){form,.cards{grid-template-columns:1fr}main{padding:15px}td,th{padding:10px}}</style>
<script>
const names:Record<string,string>={'prestige-coach-service':'Prestige Coach Service','tourgo':'Tourgo Partybussen','party-bussen-westland':'Party Bussen Westland','startransfer':'StarTransfer','tc-specialistische-reiniging':'TC Specialistische Reiniging · SchoonVakmannen'};
const regions:Record<string,string>={'noord-brabant':'Noord-Brabant','zuid-holland':'Zuid-Holland','utrecht':'Utrecht','noord-holland':'Amsterdam','zeeland':'Zeeland','limburg':'Limburg','noord-brabant-limburg':'Noord-Brabant en Limburg'};
const el=(id:string)=>document.getElementById(id)!;
const filters=el('filters') as HTMLFormElement;
let token=sessionStorage.getItem('partner-analytics-token')||'';
if(location.hash.length>1){token=location.hash.slice(1);history.replaceState(null,'',location.pathname);sessionStorage.setItem('partner-analytics-token',token);}
let pages:any[]=[];
function rows(id:string,data:any[],render:(r:any)=>Array<string|HTMLElement>){const body=el(id);body.replaceChildren();for(const item of data){const tr=document.createElement('tr');for(const value of render(item)){const td=document.createElement('td');if(typeof value==='string')td.textContent=value;else td.append(value);tr.append(td);}body.append(tr);}if(!data.length){const tr=document.createElement('tr');const td=document.createElement('td');td.colSpan=4;td.textContent='Geen geregistreerde klikken in deze selectie.';tr.append(td);body.append(tr);}}
function view(loggedIn:boolean){el('login').hidden=loggedIn;el('dashboard').hidden=!loggedIn;}
async function load(){el('status').textContent='Cijfers laden…';try{const query=new URLSearchParams();for(const [key,value] of new FormData(filters))if(String(value))query.set(key,String(value));const response=await fetch('/api/partner-statistieken?'+query,{headers:{Authorization:'Bearer '+token}});const data=await response.json();if(!response.ok){if(response.status===401){token='';sessionStorage.removeItem('partner-analytics-token');view(false);}throw Error(data.error||'Laden lukt niet.');}view(true);pages=data.pages;el('total').textContent=String(data.totals.clicks);el('first').textContent=data.totals.first_click?.slice(0,10)||'—';el('last').textContent=data.totals.last_click?.slice(0,10)||'—';rows('partners',data.partners,r=>[names[r.partner_id]||r.partner_id,regions[r.province_slug]||r.province_slug,String(r.clicks)]);rows('pages',data.pages,r=>{const a=document.createElement('a');a.textContent=r.municipality_name+' · '+r.page_path;if(/^\/[a-z0-9/_-]+\/$/.test(r.page_path)){a.href=r.partner_id==='tc-specialistische-reiniging'?'https://schoonvakmannen.nl'+r.page_path:r.page_path;a.target='_blank';a.rel='noopener noreferrer';}return[names[r.partner_id]||r.partner_id,a,String(r.clicks)];});rows('days',data.days,r=>[r.day,String(r.clicks)]);const all=Object.keys(names).map(id=>data.coverage.find((r:any)=>r.partner_id===id)||{partner_id:id,first_click:null,clicks:0});rows('coverage',all,r=>[names[r.partner_id],r.first_click?.slice(0,10)||'Nog geen geregistreerde klik',String(r.clicks)]);el('status').textContent='Bijgewerkt: '+new Date(data.generatedAt).toLocaleString('nl-NL');}catch(e){el('status').textContent=e instanceof Error?e.message:'Laden lukt niet.';}}
el('login-button').addEventListener('click',async()=>{const button=el('login-button') as HTMLButtonElement;button.disabled=true;el('status').textContent='Inlogmail wordt verstuurd…';try{const response=await fetch('/api/partner-statistieken',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'login'})});const data=await response.json();el('status').textContent=data.message||data.error;}catch{el('status').textContent='Verzenden lukt niet. Probeer opnieuw.';}finally{button.disabled=false;}});
filters.addEventListener('submit',event=>{event.preventDefault();load();});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-period]'))button.addEventListener('click',()=>{const n=button.dataset.period;const start=filters.elements.namedItem('start') as HTMLInputElement,end=filters.elements.namedItem('end') as HTMLInputElement;if(n==='all'){start.value='';end.value='';}else{end.value=new Date().toISOString().slice(0,10);start.value=new Date(Date.now()-(Number(n)-1)*86400000).toISOString().slice(0,10);}load();});
el('logout').addEventListener('click',()=>{token='';sessionStorage.removeItem('partner-analytics-token');pages=[];for(const id of ['partners','pages','days','coverage'])el(id).replaceChildren();view(false);el('status').textContent='Uitgelogd op dit apparaat.';});
el('csv').addEventListener('click',()=>{const quote=(v:unknown)=>'"'+String(v??'').replace(/^[=+@-]/,"'").replace(/"/g,'""')+'"';const data=[['Partner','Regio','Pagina','Plaats','Klikken'],...pages.map(r=>[names[r.partner_id]||r.partner_id,regions[r.province_slug]||r.province_slug,r.page_path,r.municipality_name,r.clicks])];const blob=new Blob(['\ufeff'+data.map(r=>r.map(quote).join(';')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='whatsapp-klikken-'+new Date().toISOString().slice(0,10)+'.csv';a.click();URL.revokeObjectURL(url);});
view(false);if(token)load();
</script>
