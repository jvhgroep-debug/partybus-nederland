---
import GuideBreadcrumbs from '../guides/GuideBreadcrumbs.astro';
import GuideImage from '../guides/GuideImage.astro';
import GuideImageSection from '../guides/GuideImageSection.astro';
import GuideChecklist from '../guides/GuideChecklist.astro';
import GuideFaqList from '../guides/GuideFaqList.astro';
import GuideRelatedLinks from '../guides/GuideRelatedLinks.astro';
import GuideCta from '../guides/GuideCta.astro';
import ReadAlso from '../gidsen/ReadAlso.astro';
import ComparisonTable from './ComparisonTable.astro';
import type { KennisbankArticle } from '../../data/kennisbank/types';
import { guideImagePool } from '../../data/guides/guideImages';
import type { GuideImageAsset } from '../../data/guides/guideImages';

interface Props {
	article: KennisbankArticle;
	formEyebrow?: string;
	formTitle?: string;
	formLead?: string;
}

const { article, formEyebrow = 'Aanvraag', formTitle, formLead } = Astro.props;
const hasHeroForm = Astro.slots.has('heroForm');
const heroPrimaryHref = article.heroPrimaryHref ?? '/gratis-partybus-offertes-aanvragen/';
const heroPrimaryLabel = article.heroPrimaryLabel ?? 'Gratis offertes aanvragen';

const imageMap: Record<string, GuideImageAsset> = {
	opstapplaats: guideImagePool.opstapplaats,
	onderweg: guideImagePool.onderweg,
	interieur: guideImagePool.interieur,
	festival: guideImagePool.festival,
	aankomst: guideImagePool.aankomst,
	terugreis: guideImagePool.terugreis,
};

const breadcrumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Kennisbank', href: '/kennisbank/' },
	{ label: article.h1 },
] as const;

/** Comparison table sits after the “verschil” section. */
const compareAfterId = 'verschil-vervoersvormen';

let imageSectionIndex = 0;
const renderedSections = article.sections.map((section) => {
	const image = section.imageKey ? imageMap[section.imageKey] : undefined;
	const position = (imageSectionIndex % 2 === 0 ? 'left' : 'right') as 'left' | 'right';
	if (image) imageSectionIndex += 1;
	return {
		...section,
		image,
		position,
		showComparison: Boolean(article.comparison) && section.id === compareAfterId,
	};
});
---

<article class="kb-article">
	<GuideBreadcrumbs items={breadcrumbs} />

	<header class:list={['kb-article__hero', 'section__inner', hasHeroForm && 'kb-article__hero--with-form']}>
		<div class="kb-article__hero-copy">
			<p class="section__eyebrow">{article.eyebrow}</p>
			<h1 class="kb-article__title">{article.h1}</h1>
			<p class="kb-article__lead">{article.lead}</p>
			<div class="kb-article__actions">
				<a class="btn btn--primary btn--lg" href={heroPrimaryHref}>
					{heroPrimaryLabel}
				</a>
				{
					hasHeroForm && article.cta.whatsappHref ? (
						<a
							class="btn btn--ghost btn--lg"
							href={article.cta.whatsappHref}
							target="_blank"
							rel="noopener noreferrer"
						>
							{article.cta.whatsappLabel ?? 'WhatsApp'}
						</a>
					) : (
						<a class="btn btn--ghost btn--lg" href="/kennisbank/">
							Alle kennisbankartikelen
						</a>
					)
				}
			</div>
		</div>
		{
			hasHeroForm && (
				<div id="offerte" class="kb-article__hero-form">
					<p class="kb-article__form-eyebrow">{formEyebrow}</p>
					{formTitle && <h2 class="kb-article__form-title">{formTitle}</h2>}
					{formLead && <p class="kb-article__form-lead">{formLead}</p>}
					<slot name="heroForm" />
				</div>
			)
		}
		<div class="kb-article__hero-media reveal">
			<GuideImage
				image={article.heroImage}
				loading="eager"
				fetchpriority="high"
				variant="full"
				sizes={hasHeroForm ? '(min-width: 960px) 48vw, 100vw' : '100vw'}
			/>
		</div>
		<p class="kb-article__trust">{article.trustNote}</p>
	</header>

	{
		renderedSections.map((section) => (
			<>
				{section.image ? (
					<GuideImageSection
						image={section.image}
						imagePosition={section.position}
						title={section.title}
						titleId={section.id}
						paragraphs={section.paragraphs}
					>
						{section.moreLink && (
							<p class="kb-article__more">
								<a href={section.moreLink.href}>{section.moreLink.label} →</a>
							</p>
						)}
					</GuideImageSection>
				) : (
					<section class="section kb-article__section" aria-labelledby={section.id}>
						<div class="section__inner reveal">
							<h2 id={section.id} class="section__title">
								{section.title}
							</h2>
							<div class="kb-article__prose">
								{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
								{section.moreLink && (
									<p class="kb-article__more">
										<a href={section.moreLink.href}>{section.moreLink.label} →</a>
									</p>
								)}
							</div>
						</div>
					</section>
				)}
				{section.showComparison && article.comparison && (
					<ComparisonTable
						title={article.comparison.title}
						lead={article.comparison.lead}
						rows={article.comparison.rows}
					/>
				)}
			</>
		))
	}

	<GuideChecklist
		eyebrow="Checklist"
		title={article.checklist.title}
		lead={article.checklist.lead}
		items={article.checklist.items}
		titleId="kb-checklist"
	/>

	<section class="section kb-article__section" aria-labelledby="kb-summary">
		<div class="section__inner reveal">
			<h2 id="kb-summary" class="section__title">{article.summary.title}</h2>
			<div class="kb-article__prose">
				{article.summary.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<GuideFaqList
		title="Veelgestelde vragen"
		lead="Antwoorden op de vragen die we het vaakst horen — zonder vaste prijzen of beschikbaarheidsgaranties."
		items={article.faqs}
	/>

	<ReadAlso
		title="Lees ook"
		guides={article.relatedLinks}
		cities={article.cityLinks}
	/>

	<GuideRelatedLinks
		eyebrow="Vervolgstappen"
		title="Handige pagina’s"
		lead="Van kostenfactoren en festivalvervoer tot contact en steden."
		items={article.relatedLinks}
	/>
</article>

<div class:list={[article.cta.onDark && 'kb-cta-on-dark']}>
	<GuideCta
		eyebrow={article.eyebrow}
		title={article.cta.title}
		lead={article.cta.lead}
		titleId="kb-cta"
		image={article.ctaImage}
		primaryHref={article.cta.primaryHref}
		primaryLabel={article.cta.primaryLabel}
		whatsappHref={article.cta.whatsappHref}
		whatsappLabel={article.cta.whatsappLabel}
		showWhatsapp={Boolean(article.cta.whatsappHref)}
	/>
</div>

<style>
	.kb-article :global(.section) {
		padding-block: clamp(3rem, 7vw, 5.5rem);
	}

	.kb-article__hero {
		padding-top: calc(var(--header-height) + 2rem);
		padding-bottom: 2rem;
	}

	.kb-article__hero--with-form {
		display: grid;
		gap: 1.25rem;
		overflow-x: clip;
	}

	.kb-article__hero-copy,
	.kb-article__hero-form,
	.kb-article__hero-media,
	.kb-article__trust {
		min-width: 0;
	}

	.kb-article__hero--with-form .kb-article__actions {
		margin-bottom: 0;
	}

	.kb-article__hero--with-form .kb-article__lead {
		max-width: 42rem;
	}

	@media (min-width: 960px) {
		.kb-article__hero--with-form {
			grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
			align-items: start;
			gap: 2rem;
		}

		.kb-article__hero-copy {
			grid-column: 1;
			grid-row: 1;
		}

		.kb-article__hero-form {
			grid-column: 2;
			grid-row: 1 / span 3;
		}

		.kb-article__hero--with-form .kb-article__hero-media {
			grid-column: 1;
			grid-row: 2;
		}

		.kb-article__hero--with-form .kb-article__trust {
			grid-column: 1;
			grid-row: 3;
		}
	}

	.kb-article__hero-form {
		scroll-margin-top: calc(var(--header-height) + 0.75rem);
		width: 100%;
		padding: clamp(1.15rem, 3vw, 1.6rem);
		border: 1px solid color-mix(in srgb, var(--color-primary) 28%, #e8e4d8);
		border-radius: var(--radius-lg);
		background: #ffffff;
		box-shadow: 0 16px 40px rgba(20, 20, 20, 0.08);
		color: #141414;
	}

	.kb-article__form-eyebrow {
		margin: 0 0 0.55rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.kb-article__form-title {
		margin: 0 0 0.65rem;
		max-width: 16ch;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3vw, 1.85rem);
		line-height: 1.15;
		color: #141414;
	}

	.kb-article__form-lead {
		margin: 0 0 1.15rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #4f4f4b;
	}

	.kb-article__hero-form :global(.quote-form) {
		max-width: none;
	}

	.kb-article__hero-form :global(.quote-form__field) {
		color: #141414;
	}

	.kb-article__hero-form :global(.quote-form__field input),
	.kb-article__hero-form :global(.quote-form__field textarea) {
		background: #ffffff;
		color: #141414;
	}

	.kb-article__hero-form :global(.quote-form__note) {
		color: #4f4f4b;
	}

	.kb-article__hero-form :global(.quote-form__status--success) {
		border: 1px solid color-mix(in srgb, #2e7d32 45%, transparent);
		background: color-mix(in srgb, #2e7d32 10%, #ffffff);
		color: #1b5e20;
	}

	.kb-article__hero-form :global(.quote-form__status--error) {
		border: 1px solid color-mix(in srgb, #c62828 45%, transparent);
		background: color-mix(in srgb, #c62828 10%, #ffffff);
		color: #8a1f1f;
	}

	@media (max-width: 640px) {
		.kb-article__hero--with-form .kb-article__actions .btn {
			width: 100%;
		}
	}

	.kb-article__title {
		margin: 0.35rem 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 4.5vw, 3rem);
		line-height: 1.15;
		color: var(--color-text);
	}

	.kb-article__lead {
		margin: 0 0 1.5rem;
		max-width: 46rem;
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.kb-article__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
	}

	.kb-article__hero-media {
		margin-bottom: 1.25rem;
	}

	.kb-article__trust {
		margin: 0;
		max-width: 48rem;
		padding: 1rem 1.15rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-primary-line);
		background: rgba(205, 184, 128, 0.05);
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--color-text-muted);
	}

	.kb-article__prose {
		max-width: 46rem;
	}

	.kb-article__prose p {
		margin: 0 0 1.1rem;
		color: var(--color-text-muted);
		line-height: 1.75;
	}

	.kb-article__prose p:last-child {
		margin-bottom: 0;
	}

	.kb-article__more {
		margin: 1rem 0 0;
	}

	.kb-article__more a {
		color: var(--color-primary);
		font-weight: 600;
	}

	.kb-cta-on-dark :global(.guide-cta) {
		--color-text: #f7f5f0;
		--color-text-muted: #ebe6da;
		color: #f7f5f0;
	}

	.kb-cta-on-dark :global(.guide-cta__eyebrow) {
		color: var(--color-primary);
	}

	.kb-cta-on-dark :global(.guide-cta__title) {
		color: #f7f5f0;
	}

	.kb-cta-on-dark :global(.guide-cta__lead) {
		color: rgba(247, 245, 240, 0.88);
	}

	.kb-cta-on-dark :global(.btn--primary) {
		color: #111;
	}

	.kb-cta-on-dark :global(.btn--ghost) {
		background: #1a5c4a;
		color: #f7f5f0;
		border-color: color-mix(in srgb, #25d366 28%, #1a5c4a);
	}

	.kb-cta-on-dark :global(.btn--ghost:hover),
	.kb-cta-on-dark :global(.btn--ghost:focus-visible) {
		background: #166b54;
		color: #fff;
		border-color: #25d366;
	}

	.kb-cta-on-dark :global(.guide-image--cta .guide-image__frame) {
		min-height: 14rem;
		aspect-ratio: 16 / 9;
	}

	.kb-cta-on-dark :global(.guide-image--cta img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center 40%;
	}

	@media (max-width: 640px) {
		.kb-cta-on-dark :global(.guide-image--cta .guide-image__frame) {
			min-height: 12rem;
		}
	}
</style>
