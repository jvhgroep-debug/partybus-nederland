---
import type { PartnerImageAsset } from '../../data/partners/partnerMediaDistribution';
import type { TourgoPartybussenPublicProfile } from '../../data/partners/tourgoPartybussen';

interface Props {
	eyebrow: string;
	partner: TourgoPartybussenPublicProfile;
	localIntro?: string;
	galleryImages?: readonly PartnerImageAsset[];
	whatsappHref?: string;
	logo?: string;
	enableWhatsappTracking?: boolean;
}

const {
	eyebrow,
	partner,
	localIntro,
	galleryImages,
	whatsappHref,
	logo,
	enableWhatsappTracking = false,
} = Astro.props;

const { name, website, email, phone, whatsapp, media, intro } = partner;
const displayedLogo = logo ?? media.logo;
---

<section class="section regional-partner" aria-labelledby="regional-partner-title">
	<div class="section__inner regional-partner__grid">
		<div class="regional-partner__intro reveal">
			<p class="section__eyebrow">{eyebrow}</p>
			<h2 id="regional-partner-title" class="section__title">{name}</h2>
			<p class="section__lead">{localIntro ?? intro}</p>
			<ul class="regional-partner__facts">
				<li>
					<span>Telefoon</span>
					<a href={phone.href}>{phone.display}</a>
				</li>
				<li>
					<span>E-mail</span>
					<a href={`mailto:${email}`}>{email}</a>
				</li>
			</ul>
			<div class="regional-partner__actions">
				<a
					class="btn btn--primary btn--lg"
					href={whatsappHref ?? whatsapp.href}
					target="_blank"
					rel="noopener noreferrer"
					data-partner-whatsapp={enableWhatsappTracking ? 'true' : undefined}
					data-button-type={enableWhatsappTracking ? 'partner-section' : undefined}
				>
					{whatsapp.label}
				</a>
				<a class="btn btn--ghost btn--lg" href={website.href} target="_blank" rel="noopener noreferrer">
					{website.label}
				</a>
			</div>
		</div>

		<div class="regional-partner__media reveal">
			{
				displayedLogo ? (
					<img class="regional-partner__logo" src={displayedLogo} alt={`${name} logo`} loading="lazy" />
				) : null
			}

			<div class="regional-partner__gallery" aria-label={`Foto's ${name}`}>
				{
					galleryImages && galleryImages.length > 0
						? galleryImages.map((image) => (
								<figure class="regional-partner__figure">
									<img
										src={image.src}
										alt={image.alt}
										width={image.width}
										height={image.height}
										loading="lazy"
										decoding="async"
									/>
								</figure>
							))
						: media.gallery.map((src, index) => (
								<figure class="regional-partner__figure">
									<img src={src} alt={`${name} partybus ${index + 1}`} loading="lazy" />
								</figure>
							))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.regional-partner {
		background: linear-gradient(180deg, rgba(205, 184, 128, 0.12) 0%, transparent 100%);
	}

	.regional-partner__grid {
		display: grid;
		gap: 2rem;
		align-items: start;
	}

	@media (min-width: 960px) {
		.regional-partner__grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			gap: 2.5rem;
		}
	}

	.regional-partner__facts {
		margin: 1.25rem 0 1.5rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.75rem;
	}

	.regional-partner__facts li {
		display: grid;
		gap: 0.15rem;
	}

	.regional-partner__facts a {
		font-weight: 600;
		color: var(--color-text);
	}

	.regional-partner__facts span {
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}

	.regional-partner__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.regional-partner__logo {
		display: block;
		width: min(100%, 18rem);
		height: auto;
		margin-bottom: 1.25rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-primary-line);
		border-radius: 1rem;
		background: #ffffff;
		object-fit: contain;
	}

	.regional-partner__gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.regional-partner__figure {
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--color-primary) 22%, #e8e8e4);
		background: #ffffff;
		box-shadow: 0 10px 28px rgba(20, 20, 20, 0.06);
	}

	.regional-partner__gallery img {
		display: block;
		width: 100%;
		height: 10rem;
		object-fit: cover;
	}

	@media (max-width: 640px) {
		.regional-partner__gallery {
			grid-template-columns: 1fr;
		}

		.regional-partner__gallery img {
			height: 12rem;
		}
	}
</style>
