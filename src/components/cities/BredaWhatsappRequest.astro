---
import { prestigeCoachService } from '../../data/partners/prestigeCoachService';
const phone = prestigeCoachService.publicProfile.whatsapp.phone;
---
<dialog class="breda-whatsapp" data-breda-whatsapp data-phone={phone} aria-labelledby="breda-whatsapp-title">
 <form>
  <button class="close" type="button" data-close aria-label="Sluiten">×</button>
  <h2 id="breda-whatsapp-title">Wat wil je aan Prestige vragen?</h2>
  <p>Je bericht vermeldt dat je via <strong>PartybusNederland.nl – Breda</strong> komt. Controleer het straks in WhatsApp en druk daar zelf op verzenden.</p>
  <label>Je naam (optioneel)<input name="customerName" autocomplete="name" maxlength="100" placeholder="Bijvoorbeeld Johan" /></label>
  <label>Waarvoor neem je contact op?<select name="requestType"><option>Offerte voor een partybusrit</option><option>Informatie over een partybusrit</option><option>Festivalvervoer</option><option>Vrijgezellenfeest</option><option>Bedrijfsuitje</option><option>Bruiloft of verjaardag</option></select></label>
  <div class="fields"><label>Gewenste datum<input name="date" type="date" /></label><label>Aantal personen<input name="guests" type="number" min="1" max="80" step="1" placeholder="Bijvoorbeeld 30" /></label></div>
  <label>Vertrekplaats / opstapadres<input name="departure" maxlength="250" value="Breda" /></label>
  <label>Bestemming / festival<input name="destination" maxlength="250" placeholder="Waar willen jullie naartoe?" /></label>
  <label>Terugreis nodig?<select name="returnTrip"><option>Nog te bespreken</option><option>Ja</option><option>Nee</option></select></label>
  <label>Je vraag of extra wensen<textarea name="message" maxlength="2000" rows="3"></textarea></label>
  <button class="continue" type="submit">Verder naar WhatsApp van Prestige</button>
  <p class="note">Je gegevens worden in het WhatsApp-bericht gezet. Er wordt hier niets automatisch verzonden.</p>
 </form>
</dialog>
<script>
const dialog = document.querySelector<HTMLDialogElement>('[data-breda-whatsapp]');
if(dialog && typeof dialog.showModal === 'function') {
 const form = dialog.querySelector<HTMLFormElement>('form')!;
 let previousFocus: HTMLElement | null = null;
 document.addEventListener('click', event => {
  const anchor = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
  if(!anchor || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
  const url = new URL(anchor.href);
  if(url.hostname !== 'wa.me' || url.pathname !== '/'+dialog.dataset.phone) return;
  event.preventDefault();
  previousFocus = anchor;
  if(!dialog.open) dialog.showModal();
 });
 dialog.querySelector('[data-close]')!.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('close',()=>previousFocus?.focus());
 form.addEventListener('submit', event => {
  event.preventDefault();
  if(!form.reportValidity()) return;
  const data = new FormData(form);
  const value = (name:string) => String(data.get(name)||'').trim();
  const message = [
   'Goedendag Prestige Coach Service,', '',
   'Ik kom via PartybusNederland.nl, de pagina voor Breda.',
   `Mijn aanvraag: ${value('requestType')}.`, '',
   `Mijn naam: ${value('customerName') || '[vul je naam hier in]'}`,
   `Gewenste datum: ${value('date') || 'Nog te bespreken'}`,
   `Aantal personen: ${value('guests') || 'Nog te bespreken'}`,
   `Vertrekplaats / opstapadres: ${value('departure') || 'Breda'}`,
   `Bestemming / festival: ${value('destination') || 'Nog te bespreken'}`,
   `Terugreis nodig: ${value('returnTrip')}`,
   'Gewenste vertrektijd: [vul hier in]',
   'Gewenste terugreistijd: [vul hier in]',
   `Mijn vraag / extra wensen: ${value('message') || 'Graag informatie over mogelijkheden, beschikbaarheid en prijs.'}`,
  ].join('\n');
  window.open(`https://wa.me/${dialog.dataset.phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
 });
}
</script>
<style>
 .breda-whatsapp{width:min(94vw,36rem);max-height:90dvh;overflow-y:auto;border:1px solid #dbc782;border-radius:1rem;padding:1.5rem;background:#fff;color:#171717}.breda-whatsapp::backdrop{background:rgba(0,0,0,.7)}form{display:grid;gap:.9rem;position:relative}h2{margin:0 2rem 0 0;font-size:1.5rem;line-height:1.3}p{margin:0;line-height:1.6}label{display:grid;gap:.35rem;font-weight:600;font-size:.95rem}input,select,textarea{min-width:0;width:100%;min-height:44px;padding:.7rem;border:1px solid #aaa;border-radius:.5rem;background:#fff;color:#171717;font:inherit}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}.close{position:absolute;right:0;top:-.3rem;min-width:44px;min-height:44px;border:0;background:transparent;color:#171717;font-size:1.7rem;cursor:pointer}.continue{min-height:48px;border:0;border-radius:.5rem;padding:.9rem;background:#146c3b;color:#fff;font:inherit;font-weight:700;cursor:pointer}.note{font-size:.85rem;color:#555}input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible{outline:3px solid #176c3b;outline-offset:3px}@media(max-width:480px){.fields{grid-template-columns:1fr}.breda-whatsapp{padding:1.1rem}}
</style>
