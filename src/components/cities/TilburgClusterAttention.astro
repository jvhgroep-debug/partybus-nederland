---
import CityIcon from './CityIcon.astro';
import type { CityWhyItem } from '../../data/cities/types';

interface Props {
	title: string;
	items: readonly CityWhyItem[];
}

const { title, items } = Astro.props;
---

<section class="section" aria-labelledby="tilburg-attention-title">
	<div class="section__inner">
		<div class="section__head reveal">
			<p class="section__eyebrow">Aandachtspunten</p>
			<h2 id="tilburg-attention-title" class="section__title">{title}</h2>
			<p class="section__lead">Waar groepen in Tilburg vaak op letten voordat ze een partybus boeken.</p>
		</div>
		<div class="tilburg-attention__grid">
			{
				items.map((item) => (
					<article class="tilburg-attention__card reveal">
						<span class="tilburg-attention__icon">
							<CityIcon name={item.icon ?? 'clock'} />
						</span>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.tilburg-attention__grid {
		display: grid;
		gap: 1.15rem;
	}

	@media (min-width: 700px) {
		.tilburg-attention__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.tilburg-attention__card {
		height: 100%;
		padding: 1.45rem 1.3rem;
		border-radius: var(--radius-md);
		border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
		background: #0a0a0a;
	}

	.tilburg-attention__icon {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 0.85rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-primary) 14%, transparent);
		color: var(--color-primary);
	}

	.tilburg-attention__card h3 {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--color-text);
	}

	.tilburg-attention__card p {
		margin: 0;
		color: var(--color-text-muted);
		line-height: 1.65;
		font-size: 0.98rem;
	}
</style>
