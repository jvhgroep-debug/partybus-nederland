---
import Button from '../buttons/Button.astro';

interface Props {
	cityName: string;
	whatsappHref: string;
	quoteHref?: string;
	partnerMode?: boolean;
	eyebrow?: string;
	headline?: string;
	whatsappLabel?: string;
	ghostLabel?: string;
}

const {
	cityName,
	whatsappHref,
	quoteHref = '/gratis-partybus-offertes-aanvragen/',
	partnerMode = false,
	eyebrow = `Partybus vanuit ${cityName} nodig?`,
	headline = 'Vergelijk gratis meerdere voorstellen voor jullie datum en route.',
	whatsappLabel = 'Direct aanvragen via WhatsApp',
	ghostLabel = 'Gratis offertes aanvragen',
} = Astro.props;
const quoteIsExternal = quoteHref.startsWith('http');
---

<aside class="city-conversion section__inner reveal" aria-label={`Partybus vanuit ${cityName}`}>
	<div>
		<p>{eyebrow}</p>
		<strong>{headline}</strong>
	</div>
	<div class="city-conversion__actions">
		{
			partnerMode ? (
				<>
					<Button
						href={whatsappHref}
						target="_blank"
						rel="noopener noreferrer"
						partnerWhatsappButtonType="conversion-band"
					>
						{whatsappLabel}
					</Button>
					<Button
						href={quoteHref}
						variant="ghost"
						target={quoteIsExternal ? '_blank' : undefined}
						rel={quoteIsExternal ? 'noopener noreferrer' : undefined}
					>
						{ghostLabel}
					</Button>
				</>
			) : (
				<>
					<Button href={quoteHref}>Vergelijk offertes</Button>
					<Button href={whatsappHref} variant="ghost" target="_blank" rel="noopener noreferrer">WhatsApp</Button>
				</>
			)
		}
	</div>
</aside>

<style>
	.city-conversion {
		margin-block: clamp(1rem, 3vw, 2rem);
		padding: clamp(1.35rem, 3vw, 2rem);
		display: grid;
		gap: 1.25rem;
		align-items: center;
		border: 1px solid color-mix(in srgb, var(--color-primary) 52%, transparent);
		border-radius: var(--radius-lg);
		background: linear-gradient(120deg, color-mix(in srgb, var(--color-primary) 16%, #080808), #080808);
	}

	.city-conversion p {
		margin: 0 0 0.2rem;
		color: var(--color-primary);
		font-family: var(--font-display);
		font-weight: 700;
	}

	.city-conversion strong {
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.3vw, 1.45rem);
		line-height: 1.35;
	}

	.city-conversion__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	@media (min-width: 850px) {
		.city-conversion {
			grid-template-columns: 1fr auto;
		}
	}

	@media (max-width: 640px) {
		.city-conversion__actions,
		.city-conversion__actions :global(.btn) {
			width: 100%;
		}
	}
</style>
