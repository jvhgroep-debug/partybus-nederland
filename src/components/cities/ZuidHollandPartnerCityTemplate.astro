---
import type { CityPageData } from '../../data/cities/types';
import { getRelatedCities } from '../../data/cities/registry';
import {
	buildTourgoLocalIntro,
	buildTourgoWhatsappHref,
	resolveTourgoCityMedia,
	tourgoPartybussen,
	tourgoPartybussenLogo,
} from '../../data/partners/tourgoPartybussen';
import CityHero from './CityHero.astro';
import CityIntro from './CityIntro.astro';
import CityDestinations from './CityDestinations.astro';
import CityActivities from './CityActivities.astro';
import CityOccasions from './CityOccasions.astro';
import CityTrustBar from './CityTrustBar.astro';
import CityWhy from './CityWhy.astro';
import CityHowItWorks from './CityHowItWorks.astro';
import CityPickupLocations from './CityPickupLocations.astro';
import CityConversionBand from './CityConversionBand.astro';
import CityFaq from './CityFaq.astro';
import CityRelatedCities from './CityRelatedCities.astro';
import CityCta from './CityCta.astro';
import InfoGuide from '../shared/InfoGuide.astro';
import RegionalPartnerSection from '../partners/RegionalPartnerSection.astro';
import {
	bookingTips,
	cityInfoLead,
	compareChecklist,
	pricingFactors,
} from '../../data/guides/partybusInfo';

interface Props {
	city: CityPageData;
}

const { city } = Astro.props;
const relatedCities = getRelatedCities(city.slug, city.relatedCitySlugs, 5);
const partnerCityMedia = resolveTourgoCityMedia(city.slug);
const heroImage = partnerCityMedia.hero;
const whatsappHref = buildTourgoWhatsappHref(city.name);
const quoteHref = '/gratis-partybus-offertes-aanvragen/';
const localPartnerIntro = buildTourgoLocalIntro(city.name, city.slug);
const partnerOccasions = city.occasions.items.map((item, index) => ({
	...item,
	image: partnerCityMedia.gallery[index % partnerCityMedia.gallery.length].src,
	infoHref: null,
}));
const introImage = partnerCityMedia.gallery[0].src;
const ctaImage = partnerCityMedia.gallery[2 % partnerCityMedia.gallery.length].src;
const partnerGallery = partnerCityMedia.gallery.slice(0, 4);
const requestSteps = [
	{
		title: 'Deel jullie rit',
		text: `Vul datum, groepsgrootte, opstapplaats in ${city.name}, bestemming en gewenste tijden in.`,
	},
	{
		title: 'Vergelijk voorstellen',
		text: 'Bekijk prijs, buscapaciteit, faciliteiten en voorwaarden van passende aanbieders naast elkaar.',
	},
	{
		title: 'Kies zelf',
		text: 'Je aanvraag is vrijblijvend. Jij bepaalt welke aanbieder het beste past en maakt de boeking rechtstreeks rond.',
	},
] as const;
---

<div class="master-city master-city--zh-light">
	<CityHero
		title={city.h1}
		subtitle={city.hero.subtitle}
		image={heroImage.src}
		imageAlt={heroImage.alt}
		imageWidth={heroImage.width}
		imageHeight={heroImage.height}
		mobileImage={partnerCityMedia.mobileHero.src}
		mobileImageWidth={partnerCityMedia.mobileHero.width}
		mobileImageHeight={partnerCityMedia.mobileHero.height}
		whatsappHref={whatsappHref}
		primaryHref={quoteHref}
		trustItems={city.hero.trustItems}
		partnerMode={true}
	/>

	<CityTrustBar items={city.hero.trustItems ?? []} />

	<CityIntro
		title={city.intro.title}
		paragraphs={city.intro.paragraphs}
		image={introImage}
		imageAlt={city.intro.imageAlt}
	/>

	<CityWhy title={`Waarom een partybus huren vanuit ${city.name}?`} lead={city.why.lead} items={city.why.items} />

	<CityOccasions
		title={city.occasions.title}
		lead={city.occasions.lead}
		items={partnerOccasions}
		partnerWhatsappHref={whatsappHref}
	/>

	<CityConversionBand
		cityName={city.name}
		whatsappHref={whatsappHref}
		quoteHref={quoteHref}
		partnerMode={true}
	/>

	<RegionalPartnerSection
		eyebrow="Onze partybuspartner voor Zuid-Holland"
		partner={tourgoPartybussen.publicProfile}
		localIntro={localPartnerIntro}
		galleryImages={partnerGallery}
		whatsappHref={whatsappHref}
		logo={tourgoPartybussenLogo}
		enableWhatsappTracking={true}
	/>

	<CityHowItWorks steps={requestSteps} />

	<InfoGuide
		eyebrow="Informatie"
		title={`Partybus vanuit ${city.name}: prijzen & tips`}
		lead={cityInfoLead(city.name)}
		cards={pricingFactors}
		checklist={compareChecklist}
	/>

	<CityPickupLocations
		title={city.pickup.title}
		lead={city.pickup.lead}
		items={city.pickup.items}
		note={city.pickup.note}
	/>

	<CityDestinations
		title={city.locations.title}
		lead={city.locations.lead}
		items={city.locations.items}
		eyebrow="Bestemmingen"
	/>

	<CityActivities
		title={city.activities.title}
		lead={city.activities.lead}
		items={city.activities.items}
		eyebrow="Festivals"
	/>

	<InfoGuide
		eyebrow="Tips"
		title={`Praktische tips voor een rit vanuit ${city.name}`}
		lead={`Zo bereid je een partybusrit vanuit ${city.name} goed voor — van route tot voorwaarden.`}
		cards={bookingTips}
	/>

	<CityFaq items={city.faqs} cityName={city.name} />

	{relatedCities.length > 0 && <CityRelatedCities cityName={city.name} cities={relatedCities} />}

	<nav class="master-city__links section__inner" aria-label="Vervolgstappen">
		<a href={quoteHref}>Gratis offertes aanvragen →</a>
		<a href="/hoe-werkt-het/">Hoe werkt vergelijken? →</a>
		<a href="/#diensten">Bekijk diensten →</a>
		<a href="/gids/partybus-huren/">Meer lezen in de partybus-gids →</a>
		<a href="/kennisbank/">Naar de kennisbank →</a>
	</nav>

	<CityCta
		title={city.cta.title}
		text={city.cta.text}
		whatsappHref={whatsappHref}
		image={ctaImage}
		primaryHref={quoteHref}
		partnerMode={true}
	/>
</div>

<style>
	.master-city--zh-light {
		--color-background: #f6f5f2;
		--color-surface: #ffffff;
		--color-text: #141414;
		--color-text-muted: #4f4f4b;
		--zh-on-dark: #f7f5f0;
		--zh-on-dark-muted: #ebe6da;
		background: var(--color-background);
		color: var(--color-text);
	}

	.master-city--zh-light :global(.section) {
		padding-block: clamp(4.75rem, 10vw, 8.25rem);
	}

	.master-city--zh-light > :global(.section:nth-child(odd)) {
		background-color: #ffffff;
	}

	.master-city--zh-light > :global(.section:nth-child(even)) {
		background-color: #f0efeb;
	}

	.master-city--zh-light :global(.city-trust) {
		background: #ffffff;
		border-block: 1px solid color-mix(in srgb, var(--color-primary) 18%, #e6e6e2);
		color: #141414;
	}

	.master-city--zh-light :global(.city-why__card) {
		background: #ffffff;
		box-shadow: 0 10px 28px rgba(20, 20, 20, 0.06);
	}

	.master-city--zh-light :global(.city-intro__visual) {
		background: #ececea;
	}

	.master-city--zh-light :global(.city-conversion) {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-primary) 16%, #ffffff),
			#ffffff
		);
		border: 1px solid color-mix(in srgb, var(--color-primary) 20%, #ececea);
		color: #141414;
	}

	.master-city--zh-light :global(.city-conversion strong) {
		color: #141414;
	}

	.master-city--zh-light :global(.city-cta) {
		background: #ffffff;
	}

	.master-city--zh-light :global(.city-hero),
	.master-city--zh-light :global(.city-cta__panel) {
		--color-text: var(--zh-on-dark);
		--color-text-muted: var(--zh-on-dark-muted);
		color: var(--zh-on-dark);
	}

	.master-city--zh-light :global(.info-guide__card),
	.master-city--zh-light :global(.info-guide__checklist),
	.master-city--zh-light :global(.city-pickup__item),
	.master-city--zh-light :global(.city-how__card),
	.master-city--zh-light :global(.city-act__card),
	.master-city--zh-light :global(.city-faq__item),
	.master-city--zh-light :global(.city-occ__card),
	.master-city--zh-light :global(.city-dest__card),
	.master-city--zh-light :global(.city-related__card) {
		--color-text: var(--zh-on-dark);
		--color-text-muted: var(--zh-on-dark-muted);
		color: var(--zh-on-dark);
	}

	.master-city--zh-light :global(.info-guide__card p),
	.master-city--zh-light :global(.info-guide__checklist li),
	.master-city--zh-light :global(.city-how__card p),
	.master-city--zh-light :global(.city-act__card p),
	.master-city--zh-light :global(.city-faq__content p),
	.master-city--zh-light :global(.city-occ__body p),
	.master-city--zh-light :global(.city-dest__body p) {
		color: var(--zh-on-dark-muted);
	}

	.master-city--zh-light :global(.info-guide__card h3),
	.master-city--zh-light :global(.info-guide__checklist h3),
	.master-city--zh-light :global(.city-how__card h3),
	.master-city--zh-light :global(.city-faq__item summary),
	.master-city--zh-light :global(.city-related__name) {
		color: var(--zh-on-dark);
	}

	.master-city--zh-light :global(.city-pickup__item) {
		font-weight: 700;
	}

	.master-city--zh-light :global(.city-occ__info-link) {
		color: var(--zh-on-dark-muted);
	}

	.master-city--zh-light :global(.city-hero .btn--ghost),
	.master-city--zh-light :global(.city-cta__content .btn--ghost) {
		color: var(--zh-on-dark);
		border-color: color-mix(in srgb, var(--zh-on-dark) 48%, transparent);
	}

	.master-city--zh-light :global(.regional-partner) {
		--color-text: #141414;
		--color-text-muted: #4f4f4b;
		color: #141414;
	}

	.master-city--zh-light :global(.regional-partner__facts a) {
		color: #141414;
	}

	@media (max-width: 640px) {
		.master-city--zh-light :global(.section) {
			padding-block: clamp(3.5rem, 14vw, 5rem);
		}
	}

	.master-city__links {
		display: grid;
		gap: 0.65rem;
		margin: 0 0 1.25rem;
		padding-bottom: 0;
		background: #ffffff;
	}

	.master-city__links a {
		color: #8a7340;
		font-weight: 700;
	}
</style>
