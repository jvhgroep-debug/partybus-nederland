---
import { site } from '../../data/settings/site';
import { publishedCities } from '../../data/cities/registry';
import { mainNav, primaryCta } from '../../data/settings/navigation';
import { whatsapp } from '../../data/settings/whatsapp';
import { hubGuideLinks } from '../../data/gidsen/shared';
import { gidsenPath } from '../../data/gidsen/registry';
import { trustNav, footerLegalNav } from '../../data/trust/pages';
import { servicePages } from '../../data/services/pages';
import type { RegionalFooterConfig } from '../../data/settings/regionalFooters';
import type { PartnerWhatsappTrackingContext } from '../../lib/partnerWhatsappTracking';
import Button from '../buttons/Button.astro';

interface Props {
	whatsappContact?: {
		href: string;
		label: string;
	};
	quoteHref?: string;
	attribution?: {
		prefix: string;
		label: string;
		href: string;
	};
	regionalFooter?: RegionalFooterConfig;
	partnerWhatsappTracking?: PartnerWhatsappTrackingContext;
}

const {
	whatsappContact = {
		href: whatsapp.href,
		label: `WhatsApp ${whatsapp.phoneDisplay}`,
	},
	quoteHref = primaryCta.href,
	attribution,
	regionalFooter,
	partnerWhatsappTracking,
} = Astro.props;
const year = new Date().getFullYear();
const navigationLinks = regionalFooter?.navigation ?? mainNav;
const cityLinks = regionalFooter?.locations ?? publishedCities.slice(0, 6).map((city) => ({
	label: city.name,
	href: city.path,
}));
---

<footer
	class:list={['site-footer', regionalFooter?.compact && 'site-footer--regional']}
	data-footer-region={regionalFooter?.id}
>
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<p class="site-footer__name">{site.companyName}</p>
			<p class="site-footer__text">
				Complete informatie over partybus huren — tips, bestemmingen en vrijblijvend offertes vergelijken.
			</p>
			<Button href={quoteHref} class="site-footer__cta">
				{regionalFooter?.ctaLabel ?? primaryCta.label}
			</Button>
		</div>

		{
			regionalFooter ? (
				<>
					<div class="site-footer__col">
						<p class="site-footer__heading">{regionalFooter.locationHeading}</p>
						{cityLinks.map((city) => (
							<a href={city.href}>{city.label}</a>
						))}
					</div>
					<div class="site-footer__col">
						<p class="site-footer__heading">Contact / navigatie</p>
						{navigationLinks.map((item) => (
							<a href={item.href}>{item.label}</a>
						))}
						<a
							href={whatsappContact.href}
							target="_blank"
							rel="noopener noreferrer"
							data-partner-whatsapp={partnerWhatsappTracking ? 'true' : undefined}
							data-button-type={partnerWhatsappTracking ? 'footer' : undefined}
						>
							{whatsappContact.label}
						</a>
					</div>
				</>
			) : (
				<>
					<div class="site-footer__col">
						<p class="site-footer__heading">Navigatie</p>
						{navigationLinks.map((item) => (
							<a href={item.href}>{item.label}</a>
						))}
					</div>
					<div class="site-footer__col">
						<p class="site-footer__heading">Steden</p>
						{cityLinks.map((city) => (
							<a href={city.href}>{city.label}</a>
						))}
						<a href="/#steden">Alle steden</a>
					</div>
					<div class="site-footer__col">
						<p class="site-footer__heading">Diensten</p>
						{servicePages.slice(0, 6).map((service) => (
							<a href={service.path}>{service.eyebrow}</a>
						))}
						<a href="/#diensten">Alle diensten</a>
					</div>
					<div class="site-footer__col">
						<p class="site-footer__heading">Kennisbank</p>
						{hubGuideLinks.slice(0, 5).map((guide) => (
							<a href={gidsenPath(guide.slug)}>{guide.label}</a>
						))}
						<a href="/gidsen/">Alle gidsen</a>
						<a href="/sitemap/">Sitemap</a>
					</div>
					<div class="site-footer__col">
						<p class="site-footer__heading">Contact</p>
						<a href="/contact/">Contactpagina</a>
						<a
							href={whatsappContact.href}
							target="_blank"
							rel="noopener noreferrer"
							data-partner-whatsapp={partnerWhatsappTracking ? 'true' : undefined}
							data-button-type={partnerWhatsappTracking ? 'footer' : undefined}
						>
							{whatsappContact.label}
						</a>
						<a href={quoteHref}>{primaryCta.label}</a>
						<a href="/over-ons/">Over ons</a>
					</div>
				</>
			)
		}
	</div>

	<div class="site-footer__bottom">
		<div class="site-footer__credits">
			<p class="site-footer__copy">© {site.companyName} {year}</p>
			{
				attribution && (
					<p class="site-footer__attribution">
						{attribution.prefix}{' '}
						<a href={attribution.href} target="_blank" rel="noopener noreferrer">
							{attribution.label}
						</a>
					</p>
				)
			}
		</div>
		<div class="site-footer__nav-rows">
			{
				!regionalFooter && (
					<nav class="site-footer__legal" aria-label="Over Partybus Nederland">
						{trustNav.map((item, index) => (
							<span class="site-footer__legal-item">
								{index > 0 && <span class="site-footer__sep" aria-hidden="true">·</span>}
								<a href={item.href}>{item.label}</a>
							</span>
						))}
					</nav>
				)
			}
			<nav class="site-footer__legal" aria-label="Juridische informatie">
				{
					footerLegalNav.map((item, index) => (
						<span class="site-footer__legal-item">
							{index > 0 && <span class="site-footer__sep" aria-hidden="true">·</span>}
							<a href={item.href}>{item.label}</a>
						</span>
					))
				}
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--color-primary-line);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-primary) 8%, transparent), transparent 40%),
			var(--color-surface);
		padding-top: clamp(3.5rem, 7vw, 5.25rem);
	}

	.site-footer--regional {
		padding-top: clamp(2.25rem, 4vw, 3.4rem);
	}

	.site-footer__inner {
		width: min(100% - 1.5rem, var(--content-max-width));
		margin-inline: auto;
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 640px) {
		.site-footer__inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2.75rem 2rem;
		}
	}

	@media (min-width: 1150px) {
		.site-footer__inner {
			grid-template-columns: 1.35fr repeat(5, 1fr);
			gap: 2.5rem;
		}

		.site-footer--regional .site-footer__inner {
			grid-template-columns: 1.3fr 1.15fr 1fr;
			gap: 2rem;
		}
	}

	.site-footer__name {
		margin: 0 0 0.9rem;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--color-primary);
	}

	.site-footer__text {
		margin: 0 0 1.25rem;
		max-width: 28rem;
		color: var(--color-text-muted);
		line-height: 1.7;
		font-size: 1rem;
	}

	.site-footer__cta {
		min-height: 2.7rem;
		font-size: 0.9rem;
	}

	.site-footer__heading {
		margin: 0 0 1.1rem;
		font-family: var(--font-display);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.site-footer__col {
		display: grid;
		align-content: start;
		gap: 0.9rem;
	}

	.site-footer--regional .site-footer__inner {
		gap: 1.75rem;
	}

	.site-footer--regional .site-footer__text {
		margin-bottom: 0.9rem;
	}

	.site-footer--regional .site-footer__heading {
		margin-bottom: 0.65rem;
	}

	.site-footer--regional .site-footer__col {
		gap: 0.5rem;
	}

	.site-footer--regional .site-footer__col a {
		font-size: 0.94rem;
		padding-block: 0.05rem;
	}

	.site-footer__col a {
		color: var(--color-text-muted);
		font-size: 1rem;
		line-height: 1.45;
		padding-block: 0.15rem;
		transition: color 0.2s var(--ease-out);
	}

	.site-footer__col a:hover,
	.site-footer__col a:focus-visible {
		color: var(--color-text);
	}

	.site-footer__bottom {
		width: min(100% - 1.5rem, var(--content-max-width));
		margin: 3rem auto 0;
		padding: 1.5rem 0 2rem;
		border-top: 1px solid var(--color-primary-line);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		color: var(--color-text-muted);
		font-size: 0.92rem;
	}

	.site-footer--regional .site-footer__bottom {
		margin-top: 2rem;
		padding-block: 1rem 1.35rem;
	}

	.site-footer__copy {
		margin: 0;
	}

	.site-footer__credits {
		display: grid;
		gap: 0.35rem;
	}

	.site-footer__attribution {
		margin: 0;
		font-size: 0.84rem;
		color: color-mix(in srgb, var(--color-text-muted) 82%, transparent);
	}

	.site-footer__attribution a {
		color: var(--color-primary);
		transition: color 0.2s var(--ease-out);
	}

	.site-footer__attribution a:hover,
	.site-footer__attribution a:focus-visible {
		color: var(--color-text);
	}

	.site-footer__nav-rows {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.site-footer__legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.15rem;
		line-height: 1.6;
	}

	.site-footer__legal-item {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
	}

	.site-footer__legal a {
		color: var(--color-text-muted);
		padding: 0.2rem 0.35rem;
		border-radius: 0.25rem;
		transition: color 0.2s var(--ease-out);
	}

	.site-footer__legal a:hover,
	.site-footer__legal a:focus-visible {
		color: var(--color-primary);
		outline: none;
	}

	.site-footer__legal a:focus-visible {
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 55%, transparent);
	}

	.site-footer__sep {
		color: color-mix(in srgb, var(--color-text-muted) 70%, transparent);
		user-select: none;
		padding-inline: 0.15rem;
	}

	@media (min-width: 900px) {
		.site-footer__bottom {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1.5rem;
		}

		.site-footer__nav-rows {
			align-items: flex-end;
		}

		.site-footer__legal {
			justify-content: flex-end;
		}
	}
</style>
