---
import type { PartnerWhatsappButtonType } from '../../lib/partnerWhatsappTracking';

interface Props {
	href: string;
	variant?: 'primary' | 'ghost';
	size?: 'md' | 'lg';
	class?: string;
	target?: string;
	rel?: string;
	partnerWhatsappButtonType?: PartnerWhatsappButtonType;
}

const {
	href,
	variant = 'primary',
	size = 'md',
	class: className,
	target,
	rel,
	partnerWhatsappButtonType,
} = Astro.props;
---

<a
	class:list={['btn', `btn--${variant}`, size === 'lg' && 'btn--lg', className]}
	href={href}
	target={target}
	rel={rel}
	data-partner-whatsapp={partnerWhatsappButtonType ? 'true' : undefined}
	data-button-type={partnerWhatsappButtonType}
>
	<slot />
</a>