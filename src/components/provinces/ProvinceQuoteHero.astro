---
import type { PartnerImageAsset } from '../../data/partners/partnerMediaDistribution';
import type { PartnerWhatsappButtonType } from '../../lib/partnerWhatsappTracking';
import Button from '../buttons/Button.astro';
import QuoteForm from '../forms/QuoteForm.astro';

type HeroBreadcrumb = {
	label: string;
	href: string;
	current?: boolean;
};

interface Props {
	breadcrumbs: readonly HeroBreadcrumb[];
	eyebrow: string;
	title: string;
	lead: string;
	trustItems: readonly string[];
	whatsappHref: string;
	whatsappLabel: string;
	whatsappButtonType?: PartnerWhatsappButtonType;
	logo: string;
	logoAlt: string;
	photo: PartnerImageAsset;
	sourcePage: string;
	defaultCity: string;
	formTitle: string;
	formLead: string;
	partnerId?: string;
	partnerCity?: string;
	submitLabel?: string;
}

const {
	breadcrumbs,
	eyebrow,
	title,
	lead,
	trustItems,
	whatsappHref,
	whatsappLabel,
	whatsappButtonType = 'province-hero',
	logo,
	logoAlt,
	photo,
	sourcePage,
	defaultCity,
	formTitle,
	formLead,
	partnerId,
	partnerCity,
	submitLabel,
} = Astro.props;
---

<header class="pq-hero">
	<div class="section__inner pq-hero__grid">
		<div class="pq-hero__main">
			<div class="pq-hero__copy">
				<nav class="pq-hero__breadcrumbs" aria-label="Broodkruimel">
					{
						breadcrumbs.map((item, index) => (
							<>
								{index > 0 && <span aria-hidden="true">/</span>}
								<a href={item.href} aria-current={item.current ? 'page' : undefined}>
									{item.label}
								</a>
							</>
						))
					}
				</nav>
				<p class="section__eyebrow">{eyebrow}</p>
				<h1>{title}</h1>
				<p>{lead}</p>
				<ul class="pq-hero__trust" aria-label="Voordelen">
					{trustItems.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="pq-hero__media">
				<img
					class="pq-hero__logo"
					src={logo}
					alt={logoAlt}
					width="480"
					height="160"
				/>
				<figure class="pq-hero__photo">
					<img
						src={photo.src}
						alt={photo.alt}
						width={photo.width}
						height={photo.height}
						fetchpriority="high"
						decoding="async"
					/>
				</figure>
			</div>
			<div class="pq-hero__actions">
				<Button
					href={whatsappHref}
					size="lg"
					target="_blank"
					rel="noopener noreferrer"
					partnerWhatsappButtonType={whatsappButtonType}
				>
					{whatsappLabel}
				</Button>
				<slot name="extra-actions" />
			</div>
		</div>
		<div id="offerte" class="pq-hero__form">
			<p class="pq-hero__form-eyebrow">Offerteaanvraag</p>
			<h2 class="pq-hero__form-title">{formTitle}</h2>
			<p class="pq-hero__form-lead">{formLead}</p>
			<QuoteForm
				sourcePage={sourcePage}
				defaultCity={defaultCity}
				partnerId={partnerId}
				partnerCity={partnerCity}
				submitLabel={submitLabel}
			/>
		</div>
	</div>
</header>

<style>
	.pq-hero {
		padding-top: calc(var(--header-height) + 1.25rem);
		padding-bottom: clamp(2rem, 5vw, 3.5rem);
		overflow-x: clip;
		background: #111111;
		color: #f7f5f0;
	}

	.pq-hero__grid {
		display: grid;
		gap: 1.5rem;
		min-width: 0;
	}

	.pq-hero__main,
	.pq-hero__copy,
	.pq-hero__media,
	.pq-hero__form,
	.pq-hero__actions {
		min-width: 0;
	}

	.pq-hero__main {
		display: grid;
		gap: 1.35rem;
		align-content: start;
	}

	.pq-hero__copy h1 {
		margin: 0 0 1rem;
		max-width: 16ch;
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		line-height: 1.08;
		color: #f7f5f0;
	}

	.pq-hero__copy > p {
		margin: 0 0 1.4rem;
		max-width: 42rem;
		font-size: 1.05rem;
		line-height: 1.7;
		color: #ebe6da;
	}

	.pq-hero__breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1rem;
		font-size: 0.92rem;
		color: rgba(247, 245, 240, 0.82);
	}

	.pq-hero__breadcrumbs a {
		color: inherit;
	}

	.pq-hero__trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.92rem;
		color: rgba(247, 245, 240, 0.88);
	}

	.pq-hero__media {
		display: grid;
		justify-items: stretch;
		gap: 1rem;
	}

	.pq-hero__logo {
		display: block;
		width: min(100%, 16rem);
		height: auto;
		justify-self: start;
		padding: 0.85rem 1rem;
		border: 1px solid color-mix(in srgb, var(--color-primary) 28%, #333);
		border-radius: 1rem;
		background: #ffffff;
		object-fit: contain;
	}

	.pq-hero__photo {
		margin: 0;
		width: 100%;
		max-width: 36rem;
		padding: 0.85rem;
		overflow: hidden;
		border: 1px solid var(--color-primary-line);
		border-radius: var(--radius-lg);
		background: #ffffff;
		box-shadow: 0 10px 28px rgba(20, 20, 20, 0.06);
	}

	.pq-hero__photo img {
		display: block;
		width: 100%;
		max-height: 24rem;
		aspect-ratio: 320 / 213;
		object-fit: cover;
		object-position: center;
		border-radius: calc(var(--radius-lg) - 0.4rem);
	}

	.pq-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.pq-hero__actions :global(.btn--ghost) {
		color: #f7f5f0;
		border-color: color-mix(in srgb, #f7f5f0 48%, transparent);
	}

	@media (min-width: 960px) {
		.pq-hero__grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
			align-items: start;
			gap: 2rem;
		}
	}

	.pq-hero__form {
		scroll-margin-top: calc(var(--header-height) + 0.75rem);
		width: 100%;
		padding: clamp(1.15rem, 3vw, 1.6rem);
		border: 1px solid color-mix(in srgb, var(--color-primary) 28%, #e8e4d8);
		border-radius: var(--radius-lg);
		background: #fbfaf6;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
		--color-text: #141414;
		--color-text-muted: #4f4f4b;
		color: #141414;
	}

	.pq-hero__form-eyebrow {
		margin: 0 0 0.55rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.pq-hero__form-title {
		margin: 0 0 0.65rem;
		max-width: 16ch;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3vw, 1.85rem);
		line-height: 1.15;
		color: #141414;
	}

	.pq-hero__form-lead {
		margin: 0 0 1.15rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #4f4f4b;
	}

	.pq-hero__form :global(.quote-form) {
		max-width: none;
	}

	.pq-hero__form :global(.quote-form__field) {
		color: #141414;
	}

	.pq-hero__form :global(.quote-form__field input),
	.pq-hero__form :global(.quote-form__field textarea) {
		background: #ffffff;
		color: #141414;
	}

	.pq-hero__form :global(.quote-form__note) {
		color: #4f4f4b;
	}

	.pq-hero__form :global(.quote-form__status--success) {
		border: 1px solid color-mix(in srgb, #2e7d32 45%, transparent);
		background: color-mix(in srgb, #2e7d32 10%, #ffffff);
		color: #1b5e20;
	}

	.pq-hero__form :global(.quote-form__status--error) {
		border: 1px solid color-mix(in srgb, #c62828 45%, transparent);
		background: color-mix(in srgb, #c62828 10%, #ffffff);
		color: #8a1f1f;
	}
</style>
