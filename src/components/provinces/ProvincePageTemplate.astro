---
import type { ProvinceMunicipality } from '../../data/provinces/noordBrabant';
import { noordBrabantProvince } from '../../data/provinces/noordBrabant';
import {
	buildPrestigeCoachServiceQuoteHref,
	buildPrestigeCoachServiceWhatsappHref,
	prestigeCoachService,
	prestigeCoachServiceCityMedia,
	prestigeCoachServiceLogo,
} from '../../data/partners/prestigeCoachService';
import Button from '../buttons/Button.astro';
import GuideFaqList from '../guides/GuideFaqList.astro';
import ProvinceMunicipalityGrid from './ProvinceMunicipalityGrid.astro';
import ProvincePartnerSection from './ProvincePartnerSection.astro';
import ProvinceQuoteHero from './ProvinceQuoteHero.astro';

interface Props {
	municipalities: ProvinceMunicipality[];
}

const { municipalities } = Astro.props;
const province = noordBrabantProvince;
const partner = prestigeCoachService.publicProfile;
const quotePath = buildPrestigeCoachServiceQuoteHref('Noord-Brabant', province.path);
const whatsappHref = buildPrestigeCoachServiceWhatsappHref('Noord-Brabant');
const heroPhoto = prestigeCoachServiceCityMedia.desktopHeroes[0];
const sectionImages = {
	huren: {
		src: partner.media.gallery[5] ?? partner.media.hero ?? province.heroImage,
		width: 1200,
		height: 800,
		alt: 'Prestige Coach Service partybus tijdens een avondrit',
	},
	groepsvervoer: {
		src: partner.media.gallery[2] ?? partner.media.hero ?? province.heroImage,
		width: 1600,
		height: 1067,
		alt: 'Luxe interieur voor partybus groepsvervoer in Noord-Brabant',
	},
	feesten: {
		src: partner.media.gallery[6] ?? partner.media.hero ?? province.heroImage,
		width: 1200,
		height: 800,
		alt: 'Feestelijke sfeer in een partybus van Prestige Coach Service',
	},
	festivals: {
		src: partner.media.gallery[7] ?? partner.media.hero ?? province.heroImage,
		width: 1200,
		height: 904,
		alt: 'Groep bij een partybus voor festivalvervoer',
	},
	bedrijfsfeesten: {
		src: partner.media.gallery[3] ?? partner.media.hero ?? province.heroImage,
		width: 1600,
		height: 1067,
		alt: 'Premium partybusinterieur voor bedrijfsfeesten en zakelijke ritten',
	},
	partijen: {
		src: partner.media.gallery[4] ?? partner.media.hero ?? province.heroImage,
		width: 1200,
		height: 900,
		alt: 'Partybusinterieur met sfeervolle ledverlichting',
	},
} as const;
---

<article class="province-page">
	<ProvinceQuoteHero
		breadcrumbs={[
			{ label: 'Home', href: '/' },
			{ label: province.eyebrow, href: province.path, current: true },
		]}
		eyebrow="Partybus Brabant"
		title={province.h1}
		lead={province.lead}
		trustItems={[
			'56 Brabantse gemeenten',
			'Partybus groepsvervoer Noord-Brabant',
			'Vrijblijvend vergelijken',
		]}
		whatsappHref={whatsappHref}
		whatsappLabel="Vraag beschikbaarheid via WhatsApp"
		whatsappButtonType="province-hero"
		logo={prestigeCoachServiceLogo}
		logoAlt={`${partner.name} logo`}
		photo={heroPhoto}
		sourcePage={province.path}
		defaultCity="Noord-Brabant"
		formTitle="Partybus Noord-Brabant vergelijken?"
		formLead="Vul één aanvraag in voor partybus huren Brabant. Je ontvangt vrijblijvend meerdere offertes en kiest zelf de aanbieder die past bij route, groep en budget."
	/>

	<section class="section" aria-labelledby="province-huren-title">
		<div class="section__inner province-content reveal">
			<div class="province-content__copy">
				<h2 id="province-huren-title" class="section__title">{province.sections.huren.title}</h2>
				{province.sections.huren.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.huren.src}
					alt={sectionImages.huren.alt}
					width={sectionImages.huren.width}
					height={sectionImages.huren.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section province-section--soft" aria-labelledby="province-groepsvervoer-title">
		<div class="section__inner province-content province-content--reverse reveal">
			<div class="province-content__copy">
				<h2 id="province-groepsvervoer-title" class="section__title">{province.sections.groepsvervoer.title}</h2>
				{province.sections.groepsvervoer.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.groepsvervoer.src}
					alt={sectionImages.groepsvervoer.alt}
					width={sectionImages.groepsvervoer.width}
					height={sectionImages.groepsvervoer.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-feesten-title">
		<div class="section__inner province-content reveal">
			<div class="province-content__copy">
				<h2 id="province-feesten-title" class="section__title">{province.sections.feesten.title}</h2>
				{province.sections.feesten.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.feesten.src}
					alt={sectionImages.feesten.alt}
					width={sectionImages.feesten.width}
					height={sectionImages.feesten.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section province-section--soft" aria-labelledby="province-festivals-title">
		<div class="section__inner province-content province-content--reverse reveal">
			<div class="province-content__copy">
				<h2 id="province-festivals-title" class="section__title">{province.sections.festivals.title}</h2>
				{province.sections.festivals.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.festivals.src}
					alt={sectionImages.festivals.alt}
					width={sectionImages.festivals.width}
					height={sectionImages.festivals.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-bedrijfsfeesten-title">
		<div class="section__inner province-content reveal">
			<div class="province-content__copy">
				<h2 id="province-bedrijfsfeesten-title" class="section__title">{province.sections.bedrijfsfeesten.title}</h2>
				{province.sections.bedrijfsfeesten.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.bedrijfsfeesten.src}
					alt={sectionImages.bedrijfsfeesten.alt}
					width={sectionImages.bedrijfsfeesten.width}
					height={sectionImages.bedrijfsfeesten.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section province-section--soft" aria-labelledby="province-partijen-title">
		<div class="section__inner province-content province-content--reverse reveal">
			<div class="province-content__copy">
				<h2 id="province-partijen-title" class="section__title">{province.sections.partijen.title}</h2>
				{province.sections.partijen.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<figure class="province-content__media">
				<img
					src={sectionImages.partijen.src}
					alt={sectionImages.partijen.alt}
					width={sectionImages.partijen.width}
					height={sectionImages.partijen.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<ProvincePartnerSection partner={partner} whatsappHref={whatsappHref} logo={prestigeCoachServiceLogo} />

	<ProvinceMunicipalityGrid municipalities={municipalities} />

	<section class="section province-cta" aria-labelledby="province-cta-title">
		<div class="section__inner province-cta__inner reveal">
			<p class="section__eyebrow">Offerte aanvragen</p>
			<h2 id="province-cta-title" class="section__title">Partybus Noord-Brabant vergelijken?</h2>
			<p class="section__lead">
				Vul één aanvraag in voor partybus huren Brabant. Je ontvangt vrijblijvend meerdere offertes en kiest
				zelf de aanbieder die past bij route, groep en budget.
			</p>
			<div class="province-cta__actions">
				<Button href={quotePath} size="lg">Gratis offertes aanvragen</Button>
				<Button href="/contact/" variant="ghost" size="lg">Contact opnemen</Button>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="province-faq-title">
		<div class="section__inner">
			<div class="section__head reveal">
				<p class="section__eyebrow">Veelgestelde vragen</p>
				<h2 id="province-faq-title" class="section__title">Vragen over partybus huren in Brabant</h2>
			</div>
			<GuideFaqList items={province.faqs} />
		</div>
	</section>
</article>

<style>
	.province-page {
		background: var(--color-background);
		color: var(--color-text);
	}

	.province-content {
		display: grid;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}

	.province-content__copy {
		min-width: 0;
	}

	.province-content__copy p {
		margin: 0 0 1rem;
		line-height: 1.75;
		color: var(--color-text-muted);
	}

	.province-content__copy p:last-child {
		margin-bottom: 0;
	}

	.province-content__media {
		position: relative;
		aspect-ratio: 4 / 3;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-primary-line);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow:
			var(--shadow-card),
			0 0 40px color-mix(in srgb, var(--color-primary) 8%, transparent);
	}

	.province-content__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 900px) {
		.province-content {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.province-content--reverse .province-content__media {
			order: -1;
		}

		.province-content__media {
			aspect-ratio: 3 / 2;
		}
	}

	.province-section--soft {
		background:
			linear-gradient(90deg, color-mix(in srgb, var(--color-primary) 5%, transparent), transparent 65%),
			var(--color-surface-alt);
	}

	.province-cta {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-primary) 16%, #ffffff),
			#ffffff
		);
	}

	.province-cta__inner {
		text-align: center;
	}

	.province-cta__inner .section__lead {
		margin-inline: auto;
	}

	.province-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}
</style>
