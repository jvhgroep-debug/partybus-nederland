---
import type { ProvinceMunicipality } from '../../data/provinces/utrecht';
import { utrechtProvince } from '../../data/provinces/utrecht';
import {
	buildPartyBussenWestlandWhatsappHref,
	partyBussenWestland,
	partyBussenWestlandLogo,
	partyBussenWestlandOfficialWebps,
} from '../../data/partners/partyBussenWestland';
import '../../styles/zuidHollandPartner.css';
import GuideFaqList from '../guides/GuideFaqList.astro';
import RegionalPartnerSection from '../partners/RegionalPartnerSection.astro';
import UtrechtPartnerHero from '../partners/UtrechtPartnerHero.astro';
import ProvinceMunicipalityGrid from './ProvinceMunicipalityGrid.astro';
import Button from '../buttons/Button.astro';

interface Props {
	municipalities: ProvinceMunicipality[];
}

const { municipalities } = Astro.props;
const province = utrechtProvince;
const partner = partyBussenWestland.publicProfile;
const whatsappHref = buildPartyBussenWestlandWhatsappHref('provincie Utrecht');
const photos = {
	hero: partyBussenWestlandOfficialWebps[0],
	touringcar: partyBussenWestlandOfficialWebps[1],
	minibus: partyBussenWestlandOfficialWebps[3],
	lounge: partyBussenWestlandOfficialWebps[5],
	koelkast: partyBussenWestlandOfficialWebps[7],
	stoelen: partyBussenWestlandOfficialWebps[8],
	interieur: partyBussenWestlandOfficialWebps[9],
	tafel: partyBussenWestlandOfficialWebps[17],
} as const;
const gallery = [
	photos.hero,
	photos.touringcar,
	photos.minibus,
	photos.lounge,
	photos.interieur,
	photos.stoelen,
	photos.koelkast,
	photos.tafel,
] as const;
const sectionImages = {
	huren: photos.hero,
	groepsvervoer: photos.touringcar,
	feesten: photos.lounge,
	festivals: photos.minibus,
	bedrijfsfeesten: photos.interieur,
	partijen: photos.tafel,
} as const;
---

<article class="zh-partner-page ut-province">
	<UtrechtPartnerHero
		breadcrumbs={[
			{ label: 'Home', href: '/' },
			{ label: 'Provincies', href: '/provincies/' },
			{ label: 'Provincie Utrecht', href: province.path, current: true },
		]}
		eyebrow="Partybus provincie Utrecht"
		title={province.h1}
		lead={province.lead}
		trustItems={[
			`${municipalities.length} gemeenten in provincie Utrecht`,
			'Partner: Party Bussen Westland',
			'Rechtstreeks WhatsApp-contact',
		]}
		whatsappHref={whatsappHref}
		whatsappButtonType="province-hero"
		photo={photos.hero}
		sourcePage={province.path}
		defaultCity="Utrecht"
		formTitle="Vraag een ritofferte aan voor provincie Utrecht"
		formLead="Vul je wensen in. PartybusNederland.nl werkt in provincie Utrecht samen met Party Bussen Westland."
	/>

	<section class="section" aria-labelledby="province-huren-title">
		<div class="section__inner ut-split">
			<div>
				<h2 id="province-huren-title" class="section__title">{province.sections.huren.title}</h2>
				{province.sections.huren.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p>Vertrekt de groep in de stad zelf? Bekijk <a href="/steden/partybus-huren-utrecht/">partybus huren vanuit Utrecht stad</a> voor de lokale opstapplanning. Lees ook <a href="/kennisbank/samenwerking-party-bussen-westland-utrecht-amsterdam/">wie jullie vervoersaanvraag behandelt</a>.</p>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.huren.src}
					alt={sectionImages.huren.alt}
					width={sectionImages.huren.width}
					height={sectionImages.huren.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-groepsvervoer-title">
		<div class="section__inner ut-split ut-split--reverse">
			<div>
				<h2 id="province-groepsvervoer-title" class="section__title">{province.sections.groepsvervoer.title}</h2>
				{province.sections.groepsvervoer.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<h3>Amersfoort en omgeving</h3>
				<p>Komen deelnemers uit <a href="/steden/partybus-huren-amersfoort/">Amersfoort</a>, <a href="/steden/partybus-huren-soest/">Soest</a> en <a href="/steden/partybus-huren-baarn/">Baarn</a>? Bepaal eerst of iedereen zelf naar één adres kan komen. Vraag anders een routevoorstel met de afzonderlijke stops.</p>
				<h3>Heuvelrug en het oosten van de provincie</h3>
				<p>Voor vertrek uit <a href="/steden/partybus-huren-utrechtse-heuvelrug/">Utrechtse Heuvelrug</a> of <a href="/steden/partybus-huren-veenendaal/">Veenendaal</a> noteer je de concrete plaats en het volledige adres. Alleen de naam van de gemeente is niet genoeg voor een ophaalafspraak.</p>
				<h3>Woerden, Nieuwegein en Houten</h3>
				<p>Een groep uit <a href="/steden/partybus-huren-woerden/">Woerden</a>, <a href="/steden/partybus-huren-nieuwegein/">Nieuwegein</a> of <a href="/steden/partybus-huren-houten/">Houten</a> hoeft niet eerst naar Utrecht Centraal. Bespreek een bereikbaar eigen vertrekadres en laat de vervoerder de mogelijkheden bevestigen.</p>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.groepsvervoer.src}
					alt={sectionImages.groepsvervoer.alt}
					width={sectionImages.groepsvervoer.width}
					height={sectionImages.groepsvervoer.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-feesten-title">
		<div class="section__inner ut-split">
			<div>
				<h2 id="province-feesten-title" class="section__title">{province.sections.feesten.title}</h2>
				{province.sections.feesten.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p>Bereid het programma voor met onze tips voor <a href="/diensten/partybus-vrijgezellenfeest/">een partybus bij een vrijgezellenfeest</a>, <a href="/diensten/partybus-verjaardag/">verjaardagsvervoer</a> of <a href="/diensten/partybus-bruiloft/">groepsvervoer bij een bruiloft</a>.</p>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.feesten.src}
					alt={sectionImages.feesten.alt}
					width={sectionImages.feesten.width}
					height={sectionImages.feesten.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-festivals-title">
		<div class="section__inner ut-split ut-split--reverse">
			<div>
				<h2 id="province-festivals-title" class="section__title">{province.sections.festivals.title}</h2>
				{province.sections.festivals.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p><a href="/provincies/utrecht/festivals/">Kies je festival en boek hier je rit →</a> of lees eerst de <a href="/gidsen/festival-vervoer/">praktische gids voor festivalvervoer</a>.</p>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.festivals.src}
					alt={sectionImages.festivals.alt}
					width={sectionImages.festivals.width}
					height={sectionImages.festivals.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-bedrijfsfeesten-title">
		<div class="section__inner ut-split">
			<div>
				<h2 id="province-bedrijfsfeesten-title" class="section__title">{province.sections.bedrijfsfeesten.title}</h2>
				{province.sections.bedrijfsfeesten.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p>Lees hoe je <a href="/kennisbank/partybus-utrecht-activiteit-vast-tijdslot/">de vaste starttijd doorgeeft bij je ritvraag</a> en <a href="/kennisbank/bedrijfsuitje-utrecht-partybus-terugrit-plannen/">de terugrit na een bedrijfsuitje vanuit Utrecht afspreekt</a>.</p>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.bedrijfsfeesten.src}
					alt={sectionImages.bedrijfsfeesten.alt}
					width={sectionImages.bedrijfsfeesten.width}
					height={sectionImages.bedrijfsfeesten.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="province-partijen-title">
		<div class="section__inner ut-split ut-split--reverse">
			<div>
				<h2 id="province-partijen-title" class="section__title">{province.sections.partijen.title}</h2>
				{province.sections.partijen.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p>Bekijk ook <a href="/gidsen/partybus-prijzen/">welke kostenfactoren de partybusprijs bepalen</a>.</p>
				<Button href={whatsappHref} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Vraag jullie ritofferte via WhatsApp</Button>
			</div>
			<figure class="ut-photo">
				<img
					src={sectionImages.partijen.src}
					alt={sectionImages.partijen.alt}
					width={sectionImages.partijen.width}
					height={sectionImages.partijen.height}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<RegionalPartnerSection
		eyebrow="Onze partner voor provincie Utrecht"
		partner={partner}
		galleryImages={gallery.slice(0, 6)}
		whatsappHref={whatsappHref}
		logo={partyBussenWestlandLogo}
		enableWhatsappTracking={true}
	/>

	<section class="section" aria-labelledby="province-gallery-title">
		<div class="section__inner">
			<div class="section__head">
				<p class="section__eyebrow">Officiële foto's</p>
				<h2 id="province-gallery-title" class="section__title">De bussen van Party Bussen Westland</h2>
				<p class="section__lead">
					Partybus, touringcar, minibus, lounge, stoelen, tafel en koelkast — rechtstreeks van Party Bussen Westland.
				</p>
			</div>
			<ul class="ut-gallery">
				{
					gallery.map((image) => (
						<li>
							<figure class="ut-photo">
								<img
									src={image.src}
									alt={image.alt}
									width={image.width}
									height={image.height}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<ProvinceMunicipalityGrid
		municipalities={municipalities}
		title="Partybus huren per gemeente in Utrecht"
		lead="Kies de gemeente waar jullie instappen voor lokale informatie over de vertrekplaats en het aanvragen van een rit."
		countLabel={`${municipalities.length} gemeenten in provincie Utrecht`}
	/>

	<GuideFaqList title="Vragen over partybus huren in provincie Utrecht" items={province.faqs} />
	<section class="section" aria-labelledby="province-request-title">
		<div class="section__inner">
			<h2 id="province-request-title" class="section__title">Bespreek jullie vertrekplaats, feestbus en terugrit</h2>
			<p>Stuur jullie plannen naar Party Bussen Westland. Laat het voertuig, de volledige route en de totaalprijs bevestigen voor je de rit boekt.</p>
			<Button href={whatsappHref} target="_blank" rel="noopener noreferrer" partnerWhatsappButtonType="cta">Bespreek de rit via WhatsApp</Button>
		</div>
	</section>
</article>

<style>
	.ut-province {
		background: #f6f5f2;
	}

	.ut-photo {
		margin: 0;
		width: 100%;
		max-width: 36rem;
		padding: 0.85rem;
		overflow: hidden;
		border: 1px solid var(--color-primary-line);
		border-radius: var(--radius-lg);
		background: #ffffff;
		box-shadow: 0 10px 28px rgba(20, 20, 20, 0.06);
	}

	.ut-photo img {
		display: block;
		width: 100%;
		max-height: 24rem;
		aspect-ratio: 320 / 213;
		object-fit: cover;
		object-position: center;
		border-radius: calc(var(--radius-lg) - 0.4rem);
	}

	.ut-split {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		min-width: 0;
	}

	.ut-split > * {
		min-width: 0;
	}

	.ut-split p {
		margin: 0 0 1rem;
		line-height: 1.75;
		color: #4f4f4b;
	}

	.ut-split a { color: #68521b; text-decoration: underline; text-underline-offset: 0.16em; }
	.ut-split h3 { margin: 1.25rem 0 0.5rem; font-size: 1.2rem; }

	.ut-split p:last-child {
		margin-bottom: 0;
	}

	@media (min-width: 900px) {
		.ut-split {
			grid-template-columns: minmax(0, 1fr) minmax(20rem, 36rem);
		}

		.ut-split--reverse .ut-photo {
			order: -1;
		}
	}

	.ut-gallery {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 1fr);
	}

	.ut-gallery .ut-photo {
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
	}

	@media (min-width: 640px) {
		.ut-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.ut-gallery .ut-photo {
			max-width: none;
			margin-inline: 0;
		}
	}

	@media (min-width: 1024px) {
		.ut-gallery {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.ut-province :global(.regional-partner__gallery) {
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}

	.ut-province :global(.regional-partner__gallery img) {
		width: 100%;
		height: auto;
		max-height: 22rem;
		aspect-ratio: 320 / 213;
		object-fit: cover;
	}

	@media (min-width: 640px) {
		.ut-province :global(.regional-partner__gallery) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
