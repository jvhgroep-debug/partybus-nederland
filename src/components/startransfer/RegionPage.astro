---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../buttons/Button.astro';
import PartnerImage from '../shared/PartnerImage.astro';
import GuideFaqList from '../guides/GuideFaqList.astro';
import BookingForm from './BookingForm.astro';
import FestivalFeeling from './FestivalFeeling.astro';
import PhotoHeader from './PhotoHeader.astro';
import {buildStarTransferWhatsappTrackingContext} from '../../lib/partnerWhatsappTracking';
import {buildStarTransferServiceSchema,compactMetaDescription} from '../../lib/starTransferSeo';
import {zeelandLocalContent} from '../../data/provinces/zeelandLocalContent';
import {starTransfer,starTransferLogo,starTransferPhotos,starTransferHeaderPhotos,zeelandFooter,buildStarTransferWhatsappHref} from '../../data/partners/starTransfer';
import {zeelandMunicipalities,zeelandProvince} from '../../data/provinces/zeeland';
import {buildWebPageSchema,buildBreadcrumbSchema,buildFaqPageSchema} from '../../lib/guides/schema';
interface Props {city?: (typeof zeelandMunicipalities)[number];}
const {city}=Astro.props;
const local=city?zeelandLocalContent[city.slug]:undefined;
const name=city?.name??'Zeeland';const path=city?.path??zeelandProvince.path;
const title=`Partybus huren ${name} | StarTransfer`;
const description=compactMetaDescription(local?local.lead:`Partybus huren vanuit ${name} bij StarTransfer, onze partner voor Zeeland. Bekijk busfoto’s, vraag festivalvervoer aan en vul je boekingsaanvraag in.`);
const canonical=`https://www.partybusnederland.nl${path}`;const href=buildStarTransferWhatsappHref(name);
const hero=starTransferHeaderPhotos[city?zeelandMunicipalities.findIndex(item=>item.slug===city.slug)%starTransferHeaderPhotos.length:0];
const generalFaqs=[{question:`Hoe boeken we een partybus vanuit ${name}?`,answer:'Vul het aanvraagformulier in of stuur jullie plannen via WhatsApp. StarTransfer bespreekt beschikbaarheid, voertuig, route en totaalprijs. De rit is definitief nadat jullie de boeking met de vervoerder bevestigen.'},{question:'Kunnen we ook vanaf een festival worden opgehaald?',answer:'Ja, je kunt een terugrit vanaf een afgesproken festival-ophaalpunt aanvragen. Vermeld festivalnaam, ophaaldatum, tijd en bestemming. StarTransfer bevestigt de bereikbare buszone.'},{question:'Wat kost een rit?',answer:'De prijs hangt af van voertuig, groepsgrootte, afstand, datum, ritduur en extra stops. Vraag een totaalprijs voor jullie eigen route; een standaardprijs is geen bevestiging van jullie rit.'},{question:'Wat zijn de busmogelijkheden?',answer:'Op de website van StarTransfer staan de Partybus, The Experience en StarTransfer V.I.P. Vermeld je voorkeur en laat StarTransfer capaciteit, bagageruimte en voorzieningen voor jullie datum bevestigen.'}];
const faqs=local?local.faqs:generalFaqs;
const breadcrumbs=[{label:'Home',href:'/'},{label:'Zeeland',href:zeelandProvince.path},...(city?[{label:city.name,href:city.path}]:[])];
---
<BaseLayout partnerWhatsappTracking={buildStarTransferWhatsappTrackingContext({municipalitySlug:city?.slug??null,municipalityName:name,pagePath:path,pageType:city?'municipality':'province'})} title={title} titleExact={true} description={description} canonical={canonical} ogImage={`https://www.partybusnederland.nl${hero.src}`} preloadImage={hero.src} pageWhatsapp={{href,label:`Vraag StarTransfer-vervoer vanuit ${name} aan`}} regionalFooter={zeelandFooter} pageQuoteHref="#boek-je-rit" jsonLd={[buildStarTransferServiceSchema(path,name),buildWebPageSchema({name:title,description,url:canonical}),buildBreadcrumbSchema(breadcrumbs),buildFaqPageSchema(faqs)]}>
<PhotoHeader title={city?`Partybus huren vanuit ${city.name} met StarTransfer`:zeelandProvince.h1} lead={local?.lead??`Het feest begint onderweg. Vraag vervoer aan voor je festival, vrijgezellenfeest, bruiloft, verjaardag of bedrijfsuitje — met vertrek vanuit Zeeland en een terugrit op afspraak.`} photo={hero} breadcrumbs={[{label:"Home",href:"/"},{label:"Zeeland",href:"/provincies/zeeland/"},...(city?[{label:city.name}]:[])]}><Button href="#boek-je-rit" size="lg">Boek hier je rit</Button><Button href={href} target="_blank" rel="noopener noreferrer" variant="ghost" partnerWhatsappButtonType="hero">Vraag via WhatsApp</Button></PhotoHeader>
<div class="section__inner content"><section><h2>{city?`Groepsvervoer vanuit ${city.name} met onze Zeeland-partner`:'StarTransfer: onze vervoerspartner in Zeeland'}</h2>{local?local.intro.map(text=><p>{text}</p>):<><p>PartybusNederland.nl werkt voor Zeeland samen met StarTransfer. Het bedrijf is gevestigd in Schiedam en behandelt jullie aanvraag voor groepsvervoer vanuit de Zeeuwse gemeenten.</p><p>Van Walcheren en de Bevelanden tot Schouwen-Duiveland, Tholen en Zeeuws-Vlaanderen: geef alle vertrekadressen meteen door. Zo kan StarTransfer de route, reistijd en het geschikte voertuig afstemmen op jullie plannen.</p></>}<p><a href="https://startransfer.nl/" target="_blank" rel="noopener noreferrer">Bekijk de website van StarTransfer →</a></p></section>
{local&&<section class="local-pickup"><h2>{local.pickupTitle}</h2>{local.pickup.map(text=><p>{text}</p>)}<p class="source"><a href={`https://www.zeeland.com/nl-nl/live-work/${local.source}`} target="_blank" rel="noopener noreferrer">Lokale achtergrond over {name} op Zeeland.com ↗</a></p></section>}
<section><h2>Kies de bus die bij jullie groep past</h2><div class="cards"><div><PartnerImage src={starTransferPhotos[0].src} alt={starTransferPhotos[0].alt} loading="lazy" /><h3>Partybus</h3><p>Groepsvervoer voor een festival, feest of avond uit. Bespreek de groepsgrootte, muziek, voorzieningen en ritplanning.</p><a href="https://startransfer.nl/feestbus/" target="_blank" rel="noopener noreferrer">Bekijk de Partybus →</a></div><div><PartnerImage src={starTransferPhotos[3].src} alt={starTransferPhotos[3].alt} loading="lazy" /><h3>The Experience</h3><p>StarTransfer beschrijft een VIP-lounge met 35 zitplaatsen, een DJ-opstelling en licht- en videovoorzieningen. Laat de uitvoering voor jullie rit bevestigen.</p><a href="https://startransfer.nl/theexperience/" target="_blank" rel="noopener noreferrer">Bekijk The Experience →</a></div><div><PartnerImage src={starTransferPhotos[6].src} alt={starTransferPhotos[6].alt} loading="lazy" /><h3>StarTransfer V.I.P.</h3><p>Bekijk de VIP-bus voor jullie feestelijke groepsreis. Vraag naar capaciteit, indeling en beschikbaarheid voor de gewenste datum.</p><a href="https://startransfer.nl/partybus/" target="_blank" rel="noopener noreferrer">Bekijk StarTransfer V.I.P. →</a></div></div></section>
<section><h2>Foto’s van de StarTransfer-bussen</h2><p>De bus- en interieurfoto’s komen van StarTransfer’s eigen website. Spreek af welk voertuig en welke voorzieningen jullie krijgen.</p><div class="photos">{starTransferPhotos.map(photo=><figure><PartnerImage src={photo.src} alt={photo.alt} loading="lazy" sizes="(max-width:640px) 100vw, (max-width:900px) 50vw, 33vw" /><figcaption>{photo.alt}</figcaption></figure>)}</div></section>
<section><h2>Festivalvervoer vanuit {name}</h2>{local?local.festival.map(text=><p>{text}</p>):<p>Naar het festival, vanaf het festivalterrein of heen en terug: geef festivalnaam, reisdatum, groepsgrootte en ophaalpunt door. Een campingweekend kan verschillende heen- en terugreisdagen vragen.</p>}<a href="/provincies/zeeland/festivals/">Kies uit 26 festivals en boek je rit vanuit Zeeland →</a></section>
<FestivalFeeling />
{local?<><section><h2>Ritvoorbeelden vanuit {name}</h2><p class="small-note">Dit zijn ideeën voor je aanvraag; StarTransfer bevestigt de mogelijkheden voor jullie datum.</p><div class="occasions">{local.examples.map(example=><div><h3>{example.title}</h3><p>{example.text}</p></div>)}</div></section><section><h2>De terugreis naar {name} goed afspreken</h2>{local.returnTrip.map(text=><p>{text}</p>)}</section></>:<section><h2>Vervoer voor jullie gelegenheid</h2><div class="occasions"><div><h3>Vrijgezellenfeest en verjaardag</h3><p>Vertrek samen, bespreek de bestemming en laat de terugrit aansluiten op jullie feestplanning.</p></div><div><h3>Bruiloft en trouwfeest</h3><p>Geef ceremonie, feestlocatie en eventuele hotelstops door. Stem ophalen en afzetten van gasten duidelijk af.</p></div><div><h3>Bedrijfsuitje en groepsreis</h3><p>Vraag een touringcar, partybus of pendeloplossing aan. Vermeld meerdere opstapplaatsen en gewenste aankomsttijden.</p></div><div><h3>Carnaval en kinderfeestje</h3><p>Bespreek de leeftijd van deelnemers, begeleiding en passende voorzieningen met StarTransfer.</p></div></div></section>}
<BookingForm departure={name} />
{!city&&<section><h2>Verandert jullie ritplan?</h2><p>Andere tijden of adressen na de aanvraag? <a href="/kennisbank/partybus-zeeland-ritwijziging-doorgeven/">Lees hoe je een wijzigingsverzoek voor StarTransfer duidelijk voorbereidt</a> en wacht op bevestiging van de vervoerder.</p></section>}
<section><h2>{city?'Andere vertrekplaatsen om mee te nemen in je aanvraag':'Alle 13 Zeeuwse gemeenten'}</h2><div class="locations">{(local?zeelandMunicipalities.filter(item=>local.neighbors.includes(item.slug)):zeelandMunicipalities).filter(item=>item.slug!==city?.slug).map(item=><a href={item.path}>Partybus {item.name} →</a>)}</div><p><a href="/provincies/zeeland/">Alle 13 gemeenten in Zeeland →</a></p></section>
<section><h2>Onze samenwerking met StarTransfer</h2><p>Lees hoe we het groeps- en festivalvervoer vanuit Zeeland samenbrengen met onze vervoerspartner.</p><a href="/kennisbank/samenwerking-startransfer-zeeland/">Lees de blog over de samenwerking →</a></section>
<section><h2>Contact en aanvraag</h2><p>StarTransfer · Fokkerstraat 521, 3125 BD Schiedam · <a href="tel:+31103810800">010 381 08 00</a> · <a href="mailto:info@startransfer.nl">info@startransfer.nl</a></p><p>WhatsApp-aanvragen lopen voorlopig via Partybus Nederland. Je aanvraag wordt met StarTransfer afgestemd; beschikbaarheid, prijs en boeking worden door de vervoerder bevestigd.</p></section></div><GuideFaqList title={`Veelgestelde vragen over partybus huren ${name}`} items={faqs} />
</BaseLayout>
<style>.hero{position:relative;isolation:isolate;background:#151515;color:white;padding-block:calc(var(--header-height) + 2rem) 3.5rem}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.94),rgba(0,0,0,.65));z-index:-1}.hero nav{margin-bottom:1.5rem}.logo{width:min(100%,260px);height:auto;margin-block:1rem}.hero h1{max-width:24ch;font-size:clamp(2rem,5vw,3.8rem);line-height:1.15}.hero p{max-width:66ch;line-height:1.8}.actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem}.content{padding-block:1rem 3rem}.content>section{margin-block:2.5rem}.content h2{font-size:clamp(1.6rem,3vw,2.5rem)}.content p{line-height:1.85}.cards,.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem}.cards>div{padding:1rem;border:1px solid var(--color-primary-line);border-radius:1rem}.cards img,.photos img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:.7rem}.photos{margin-top:1.5rem}figure{margin:0}figcaption{font-size:.85rem;padding-top:.5rem}.occasions,.locations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.locations a{padding:1rem;border:1px solid var(--color-primary-line);border-radius:.5rem}a{color:var(--color-primary)}@media(max-width:900px){.cards{grid-template-columns:1fr}.photos{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.photos,.locations,.occasions{grid-template-columns:1fr}}</style>
