---
import { starTransfer } from '../../data/partners/starTransfer';
interface Props {departure?:string;festival?:string;}
const {departure='Zeeland',festival=''}=Astro.props;
---
<section id="boek-je-rit" class="booking" data-startransfer-booking data-phone={starTransfer.publicProfile.whatsapp.phone}>
<h2>Boek hier je rit — vraag beschikbaarheid aan</h2><p>Vul jullie plannen in. StarTransfer bespreekt beschikbaarheid, voertuig en totaalprijs. Je boeking is definitief na bevestiging door de vervoerder.</p>
<form><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><div class="fields">
<label>Naam *<input name="name" required autocomplete="name" /></label><label>E-mail *<input name="email" type="email" required autocomplete="email" /></label><label>Telefoon *<input name="phone" type="tel" required autocomplete="tel" /></label><label>Aantal personen *<input name="guests" type="number" min="1" step="1" required /></label>
<label>Vertrekplaats in Zeeland *<input name="city" required value={departure} /></label><label>Opstapadres / festival-ophaalpunt *<input name="pickup" required autocomplete="street-address" /></label>
<label>Soort bus<select name="vehicle"><option>Geen voorkeur — graag advies</option><option>Partybus</option><option>The Experience</option><option>StarTransfer V.I.P.</option><option>Touringcar</option><option>Pendelbus</option></select></label><label>Soort rit<select name="trip"><option>Heen en terug</option><option>Alleen heenrit</option><option>Ophalen vanaf festival / alleen terugrit</option><option>Voertuig ter beschikking</option><option>Dagtocht / meerdaagse reis</option></select></label>
<label>Gelegenheid / festival<input name="occasion" value={festival} placeholder="Bijv. vrijgezellenfeest of festivalnaam" /></label><label>Bestemming *<input name="destination" required placeholder="Naam locatie en adres" /></label>
<label>Datum heenrit<input name="date" type="date" /></label><label>Vertrektijd heenrit<input name="departureTime" type="time" /></label><label>Datum terugrit / ophalen<input name="returnDate" type="date" /></label><label>Tijd terugrit / ophalen<input name="returnTime" type="time" /></label><label>Ophaalpunt bij festival<input name="festivalPickup" placeholder="Festivalterrein / afgesproken buszone" /></label><label>Afzetadres terugrit<input name="dropoff" /></label>
<label class="wide">Tussenstops, bagage en extra wensen<textarea name="notes" rows="4"></textarea></label></div>
<label class="consent"><input type="checkbox" required />Ik ga ermee akkoord dat mijn aanvraag en contactgegevens worden gedeeld met StarTransfer om mijn rit te bespreken. <a href="/privacybeleid/">Privacybeleid</a></label>
<div class="actions"><button type="submit">Verstuur mijn aanvraag</button><button type="button" data-send-whatsapp>Stuur deze gegevens via WhatsApp</button></div><p class="status" role="status" aria-live="polite"></p></form>
</section>
<script>
const labels={vehicle:'Soort bus',trip:'Soort rit',occasion:'Festival / gelegenheid',pickup:'Exact opstapadres',destination:'Bestemming',date:'Datum heenrit',departureTime:'Vertrektijd heenrit',returnDate:'Datum terugrit / ophalen',returnTime:'Ophaaltijd',festivalPickup:'Ophaalpunt bij festival',dropoff:'Afzetadres terugrit',notes:'Extra wensen'};
for(const root of document.querySelectorAll<HTMLElement>('[data-startransfer-booking]')){
 const form=root.querySelector('form')!;const status=root.querySelector<HTMLElement>('.status')!;const submit=form.querySelector<HTMLButtonElement>('[type=submit]')!;
 function payload():Record<string,string>{const data:Record<string,string>=Object.fromEntries(Array.from(new FormData(form).entries(),([key,value])=>[key,String(value)]));return {...data,partnerId:'startransfer',partnerCity:data.city,sourcePage:window.location.pathname,message:Object.entries(labels).map(([key,label])=>label+': '+String(data[key]||'')).join('\n')};}
 form.querySelector('[data-send-whatsapp]')!.addEventListener('click',()=>{if(!form.reportValidity())return;const data=payload();const text=['Goedendag StarTransfer,','Ik kom via PartybusNederland.nl voor een rit vanuit Zeeland.','Naam: '+data.name,'E-mail: '+data.email,'Telefoon: '+data.phone,'Aantal personen: '+data.guests,'Vertrekplaats in Zeeland: '+data.city,data.message,'Kunt u beschikbaarheid en totaalprijs bevestigen?'].join('\n');window.open('https://wa.me/'+root.dataset.phone+'?text='+encodeURIComponent(text),'_blank','noopener,noreferrer');});
 form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;submit.disabled=true;status.textContent='Je aanvraag wordt verzonden…';try{const response=await fetch('/api/offerte',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Verzenden lukt niet. Je kunt de gegevens via WhatsApp sturen.');status.textContent='Bedankt! Je aanvraag is ontvangen. StarTransfer bespreekt de beschikbaarheid en prijs met je. De rit is nog niet definitief geboekt.';form.reset();}catch(error){status.textContent=error instanceof Error?error.message:'Verzenden lukt niet. Gebruik de WhatsApp-knop.';}finally{submit.disabled=false;}});
}
</script>
<style>.booking{scroll-margin-top:calc(var(--header-height) + 1rem);padding:2rem;border:1px solid var(--color-primary-line);border-radius:1rem}.booking p{line-height:1.8}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.fields label{display:grid;gap:.5rem;font-size:.95rem}.fields input,.fields select,.fields textarea{min-width:0;width:100%;padding:.8rem;border:1px solid var(--color-primary-line);border-radius:.5rem;background:var(--color-surface-alt);color:inherit;font:inherit}.wide{grid-column:1/-1}.consent{display:flex;align-items:flex-start;gap:.6rem;line-height:1.6;margin-block:1.25rem}.consent input{margin-top:.3rem;flex-shrink:0}.actions{display:flex;gap:1rem;flex-wrap:wrap}.actions button{font:inherit;font-weight:700;padding:1rem 1.3rem;border-radius:.5rem;border:1px solid var(--color-primary);background:var(--color-primary);color:#141414;cursor:pointer}.actions button:disabled{opacity:.6;cursor:wait}.honeypot{position:absolute;left:-10000px}.status{min-height:1.8em}input:focus,select:focus,textarea:focus{outline:2px solid var(--color-primary);outline-offset:2px}@media(max-width:640px){.fields{grid-template-columns:1fr}.booking{padding:1.2rem}}</style>
