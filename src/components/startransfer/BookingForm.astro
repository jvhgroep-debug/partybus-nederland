---
import QuoteRequestFields from '../forms/QuoteRequestFields.astro';
import {starTransfer} from '../../data/partners/starTransfer';
interface Props {departure?:string;festival?:string;}
const {departure='Zeeland',festival=''}=Astro.props;
---
<section id="boek-je-rit" class="booking" data-startransfer-booking data-phone={starTransfer.publicProfile.whatsapp.phone}>
<h2>Boek hier je rit — vraag beschikbaarheid en prijs aan</h2><p>Vertel kort wat jullie willen organiseren. Partybus Nederland ontvangt je aanvraag en stuurt deze door naar StarTransfer. StarTransfer bespreekt de route, bus en totaalprijs met je. Een aanvraag is vrijblijvend; de rit wordt pas vastgelegd na bevestiging door de vervoerder.</p>
<form action="/api/offerte" method="post"><input type="hidden" name="partnerId" value="startransfer" /><input type="hidden" name="sourcePage" value={Astro.url.pathname} /><input type="hidden" name="requestId" value="" /><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
<p>Offerteaanvraag voor <strong>StarTransfer</strong> via <strong>PartybusNederland.nl</strong>.</p>
<QuoteRequestFields defaultCity={departure==='Zeeland'?'':departure} festival={festival} requiredTrip={true} partnerName="StarTransfer" />
<label class="consent"><input name="consent" type="checkbox" required />Ik ga ermee akkoord dat mijn aanvraag en contactgegevens worden gedeeld met StarTransfer om mijn rit te bespreken. <a href="/privacybeleid/">Privacybeleid</a></label>
<div class="actions"><button type="submit">Vraag beschikbaarheid en prijs aan</button><button type="button" data-send-whatsapp>Stuur mijn aanvraag via WhatsApp</button></div><p class="status" tabindex="-1" role="status" aria-live="polite"></p><p class="small">Je betaalt hier niets. WhatsApp loopt voorlopig via Partybus Nederland.</p></form>
</section>
<script>
import {buildStarTransferBookingPayload,buildStarTransferBookingWhatsapp,STARTRANSFER_RETURN_TRIP} from '../../lib/starTransferBooking';
for(const root of document.querySelectorAll<HTMLElement>('[data-startransfer-booking]')){
 const form=root.querySelector('form')!;const requestId=form.querySelector<HTMLInputElement>('[name=requestId]')!;requestId.value=crypto.randomUUID();const status=root.querySelector<HTMLElement>('.status')!;const submit=form.querySelector<HTMLButtonElement>('[type=submit]')!;const whatsapp=form.querySelector<HTMLButtonElement>('[data-send-whatsapp]')!;const trip=form.querySelector<HTMLSelectElement>('[name=trip]')!;
 function payload(){const data:Record<string,string>=Object.fromEntries(Array.from(new FormData(form).entries(),([key,value])=>[key,String(value)]));return buildStarTransferBookingPayload(data,window.location.pathname);}

 whatsapp.addEventListener('click',()=>{if(!form.reportValidity())return;const data=payload();window.open('https://wa.me/'+root.dataset.phone+'?text='+encodeURIComponent(buildStarTransferBookingWhatsapp(data)),'_blank','noopener,noreferrer');const config=(window as Window&{__PARTNER_WHATSAPP_TRACKING__?:Record<string,unknown>}).__PARTNER_WHATSAPP_TRACKING__;if(config){try{fetch('/api/partner-whatsapp-click',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...config,buttonType:'cta'}),keepalive:true}).catch(()=>{});}catch{}}});
 form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;submit.disabled=true;submit.setAttribute('aria-busy','true');status.textContent='Je aanvraag wordt verzonden…';try{const response=await fetch('/api/offerte',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...payload(),message:String(new FormData(form).get('message')||'')})});const result=await response.json().catch(()=>({ok:false,error:'Verzenden lukt niet. Je kunt dezelfde gegevens via WhatsApp sturen.'}));if(!response.ok||!result.ok)throw new Error(result.error||'Verzenden lukt niet. Je kunt dezelfde gegevens via WhatsApp sturen.');status.textContent='Bedankt! Partybus Nederland heeft je aanvraag ontvangen en stuurt deze door naar StarTransfer. StarTransfer bespreekt de beschikbaarheid en prijs met je. De rit is nog niet definitief geboekt.';submit.hidden=true;whatsapp.hidden=true;for(const field of form.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea'))field.disabled=true;status.focus();}catch(error){status.textContent=error instanceof Error?error.message:'Verzenden lukt niet. Gebruik de WhatsApp-knop.';}finally{submit.disabled=false;submit.removeAttribute('aria-busy');}});
}
</script>
<style>.booking{scroll-margin-top:calc(var(--header-height) + 1rem);padding:2rem;border:1px solid var(--color-primary-line);border-radius:1rem}.booking p{line-height:1.8}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.fields label{display:grid;gap:.5rem;font-size:.95rem}.fields input,.fields select,.fields textarea{min-width:0;width:100%;padding:.8rem;border:1px solid var(--color-primary-line);border-radius:.5rem;background:var(--color-surface-alt);color:inherit;font:inherit;min-height:44px}.fields small,.small{font-size:.85rem;line-height:1.6}.wide{grid-column:1/-1}.extra{margin-top:1.3rem;border:1px solid var(--color-primary-line);border-radius:.5rem;padding:1rem}.extra summary{cursor:pointer;font-weight:700;line-height:1.6}.extra[open] .fields{margin-top:1rem}.consent{display:flex;align-items:flex-start;gap:.6rem;line-height:1.6;margin-block:1.25rem}.consent input{margin-top:.3rem;flex-shrink:0}.actions{display:flex;gap:1rem;flex-wrap:wrap}.actions button{font:inherit;font-weight:700;padding:1rem 1.3rem;border-radius:.5rem;border:1px solid var(--color-primary);background:var(--color-primary);color:#141414;cursor:pointer;min-height:48px}.actions button:disabled{opacity:.6;cursor:wait}.honeypot{position:absolute;left:-10000px}.status{min-height:1.8em}input:focus,select:focus,textarea:focus{outline:2px solid var(--color-primary);outline-offset:2px}[hidden]{display:none!important}@media(max-width:640px){.fields{grid-template-columns:1fr}.booking{padding:1.2rem}.actions{display:grid}.actions button{width:100%}}</style>
