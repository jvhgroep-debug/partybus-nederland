---
import PartnerImage from '../shared/PartnerImage.astro';
import {starTransferLogo} from '../../data/partners/starTransfer';
interface Props {title:string;lead:string;photo:{src:string;alt:string};eyebrow?:string;breadcrumbs?:readonly {label:string;href?:string}[];}
const {title,lead,photo,eyebrow='StarTransfer · onze partner voor Zeeland',breadcrumbs=[]}=Astro.props;
---
<header class="startransfer-photo-header" data-photo-header><PartnerImage class="header-photo" src={photo.src} alt={photo.alt} loading="eager" fetchpriority="high" sizes="100vw" /><div class="section__inner header-inner">{breadcrumbs.length>0&&<nav aria-label="Broodkruimelnavigatie">{breadcrumbs.map((item,index)=><>{index>0&&' / '}{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</>)}</nav>}<img class="header-logo" src={starTransferLogo} alt="StarTransfer" /><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="header-lead">{lead}</p><div class="header-actions"><slot /></div></div></header>
<style>.startransfer-photo-header{position:relative;isolation:isolate;overflow:hidden;background:#111;color:#fff;min-height:570px;display:flex;align-items:center;padding-block:calc(var(--header-height) + 2rem) 3.5rem}.header-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-2}.startransfer-photo-header:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.84) 45%,rgba(0,0,0,.45) 100%);z-index:-1}.header-inner{width:100%}.header-inner nav{font-size:.9rem;line-height:1.7;margin-bottom:1.5rem}.header-inner nav a{color:#fff;text-decoration:underline;text-underline-offset:.2em}.header-logo{width:180px;height:auto;max-width:100%;background:rgba(0,0,0,.35);border-radius:.6rem;padding:.5rem}.eyebrow{color:#f7d580;font-size:.9rem;letter-spacing:.04em;margin-top:1.2rem}.startransfer-photo-header h1{color:#fff;max-width:26ch;font-size:clamp(2rem,4.7vw,3.6rem);line-height:1.14;margin-block:1rem}.header-lead{color:#fff;max-width:64ch;line-height:1.85;font-size:1.05rem}.header-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin-top:1.5rem}@media(max-width:640px){.startransfer-photo-header{min-height:540px;padding-block:calc(var(--header-height) + 1.3rem) 2.5rem}.startransfer-photo-header:after{background:linear-gradient(90deg,rgba(0,0,0,.92),rgba(0,0,0,.79))}.header-photo{object-position:60% center}.header-logo{width:150px}.header-actions{align-items:stretch}.startransfer-photo-header h1{max-width:100%}}</style>
