---
import BaseLayout from './BaseLayout.astro';
import type { RegionalFooterConfig } from '../data/settings/regionalFooters';

interface Props {
	title: string;
	description: string;
	canonical: string;
	preloadImage: string;
	ogTitle?: string;
	ogDescription?: string;
	ogUrl?: string;
	ogImage?: string;
	twitterCard?: string;
	twitterTitle?: string;
	twitterDescription?: string;
	twitterImage?: string;
	jsonLd: Record<string, unknown> | Record<string, unknown>[];
	pageWhatsapp?: {
		href: string;
		label: string;
	};
	pageQuoteHref?: string;
	footerAttribution?: {
		prefix: string;
		label: string;
		href: string;
	};
	regionalFooter?: RegionalFooterConfig;
}

const {
	title,
	description,
	canonical,
	preloadImage,
	ogTitle,
	ogDescription,
	ogUrl,
	ogImage,
	twitterCard,
	twitterTitle,
	twitterDescription,
	twitterImage,
	jsonLd,
	pageWhatsapp,
	pageQuoteHref,
	footerAttribution,
	regionalFooter,
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	preloadImage={preloadImage}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogUrl={ogUrl}
	ogImage={ogImage}
	twitterCard={twitterCard}
	twitterTitle={twitterTitle}
	twitterDescription={twitterDescription}
	twitterImage={twitterImage}
	titleExact={true}
	jsonLd={jsonLd}
	pageWhatsapp={pageWhatsapp}
	pageQuoteHref={pageQuoteHref}
	footerAttribution={footerAttribution}
	regionalFooter={regionalFooter}
>
	<slot />
</BaseLayout>